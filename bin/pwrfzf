#!/usr/bin/env bash
# vim:filetype=sh:shiftwidth=2:softtabstop=2:expandtab:foldmethod=marker:foldmarker=###{{{,###}}}

# ==============================================================================
# PWRFZF - Powerful Gentoo Package Manager with FZF
# A comprehensive interactive package and repository management tool for Gentoo
# ==============================================================================

# Re-execute the script in bash if not running in bash or zsh
if [ -z "${BASH_VERSION:-}" ] && [ -z "${ZSH_VERSION:-}" ]; then
  exec bash "$0" "$@"
fi

# Check and set options for bash
if [ -n "${BASH_VERSION:-}" ]; then
  shopt -s lastpipe
  export SHELL=bash
fi

# ------------------------------------------------------------------------------
# CONSTANTS & GLOBALS (DYNAMIC PORTAGEQ EXTRACTION)
# ------------------------------------------------------------------------------
readonly PWRFZF_VERSION="2.8.4"
readonly PROG="pwrfzf"
readonly AUTHOR="spikyatlinux"
readonly REPO="https://github.com/${AUTHOR}/${PROG}"

# Dynamically extract Portage paths via portageq (with sane defaults)
if command -v portageq >/dev/null 2>&1; then
  # Read basic variables in a single call for maximum performance
  mapfile -t _pq < <(portageq envvar PORTAGE_CONFIGROOT PORT_LOGDIR EMERGE_LOG_DIR 2>/dev/null)
  _P_ROOT="${_pq[0]:-/}"
  _P_LOG="${_pq[1]:-/var/log/portage}"
  _E_LOG="${_pq[2]:-/var/log}"
  
  readonly PORTAGE_ETC="${_P_ROOT%/}/etc/portage"
  readonly ELOG_DIR="${_P_LOG%/}/elog"
  readonly EMERGE_LOG="${_E_LOG%/}/emerge.log"
  
  # Use dedicated portageq commands for specific directories
  readonly DISTDIR="$(portageq distdir 2>/dev/null || echo "${_P_ROOT%/}/var/cache/distfiles")"
  readonly PKGDIR="$(portageq pkgdir 2>/dev/null || echo "${_P_ROOT%/}/var/cache/binpkgs")"
  readonly GENTOO_REPO="$(portageq get_repo_path / gentoo 2>/dev/null || echo "${_P_ROOT%/}/var/db/repos/gentoo")"
else
  # Fallback to standard Gentoo paths if portageq is missing
  readonly PORTAGE_ETC="/etc/portage"
  readonly ELOG_DIR="/var/log/portage/elog"
  readonly EMERGE_LOG="/var/log/emerge.log"
  readonly DISTDIR="/var/cache/distfiles"
  readonly PKGDIR="/var/cache/binpkgs"
  readonly GENTOO_REPO="/var/db/repos/gentoo"
fi

# Configuration directories
PWRFZF_CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/${PROG}"
PWRFZF_CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/${PROG}"
PWRFZF_CONFIG_FILE="${PWRFZF_CONFIG_DIR}/pwrfzf.conf"
OLD_CONFIG_FILE="${PWRFZF_CONFIG_DIR}/pwrfzf-config"
PWRFZF_HISTORY="${PWRFZF_CACHE_DIR}/history"
PWRFZF_INSTALL_LIST="${PWRFZF_CACHE_DIR}/install_list"
PWRFZF_LAYOUT_FILE="${PWRFZF_CACHE_DIR}/layout"

# Default configuration variables
PWRFZF_PREVIEW_WINDOW="${PWRFZF_PREVIEW_WINDOW:-right,60%,border-left}"
PWRFZF_SHOW_INSTALLED="${PWRFZF_SHOW_INSTALLED:-true}"
PWRFZF_AUTO_SYNC="${PWRFZF_AUTO_SYNC:-false}"
PWRFZF_CONFIRM_ACTIONS="${PWRFZF_CONFIRM_ACTIONS:-true}"
PWRFZF_CONFIRM_EXIT="${PWRFZF_CONFIRM_EXIT:-true}"
PWRFZF_MAX_PREVIEW_LINES="${PWRFZF_MAX_PREVIEW_LINES:-50}"
PWRFZF_LOGGING="${PWRFZF_LOGGING:-false}"
PWRFZF_HISTORY_CMD="${PWRFZF_HISTORY_CMD:-elogv}"
PWRFZF_FZF_LAYOUT="${PWRFZF_FZF_LAYOUT:-reverse}"
PWRFZF_EXACT_SEARCH="${PWRFZF_EXACT_SEARCH:-true}"
PWRFZF_SEARCH_NAMES_ONLY="${PWRFZF_SEARCH_NAMES_ONLY:-false}"
PWRFZF_EDITOR="${PWRFZF_EDITOR:-}"
PWRFZF_CONFIG_UPDATER="${PWRFZF_CONFIG_UPDATER:-cfg-update -u}"
PWRFZF_EMERGE_CMD="${PWRFZF_EMERGE_CMD:-emerge}"
PWRFZF_COLOR_THEME="${PWRFZF_COLOR_THEME:-}"
PWRFZF_GLSA_REVERSE="${PWRFZF_GLSA_REVERSE:-true}"
PWRFZF_ENABLE_KERNEL_HUB="${PWRFZF_ENABLE_KERNEL_HUB:-false}"

declare -g PWRFZF_MODE="packages"
declare -g PWRFZF_LAYOUT="default"
declare -g PRIV_ESC
declare -g EMERGE_CMD
declare -gA pwrfzf_color pwrfzf_fx

declare -gA PORTAGE_CONFIG_TYPES=(
  [accept_keywords]="Keywords (~amd64, etc.)"
  [use]="USE flags"
  [mask]="Masked packages" 
  [unmask]="Unmasked packages"
  [env]="Environment settings"
  [sets]="Package sets"
)

# ------------------------------------------------------------------------------
# INITIALIZATION & SETUP
# ------------------------------------------------------------------------------
function _pwrfzf_init() {
  _check_dependencies
  _create_directories
  _migrate_config
  _load_config
  _validate_config
  _setup_logging
  _set_colors
  _set_fx
  _find_privilege_escalator
  _find_emerge
  _load_emerge_default_opts
  _load_layout
  _clear_preview_cache
}

function _migrate_config() {
  # Automatically rename old pwrfzf-config to pwrfzf.conf if needed
  if [[ -f "$OLD_CONFIG_FILE" && ! -f "$PWRFZF_CONFIG_FILE" ]]; then
    mv "$OLD_CONFIG_FILE" "$PWRFZF_CONFIG_FILE" 2>/dev/null
  fi
}

function _setup_logging() {
  if [[ "${PWRFZF_LOGGING:-false}" == "true" ]]; then
    local log_file="${PWRFZF_CONFIG_DIR}/pwrfzf.log"
    mkdir -p "$(dirname "$log_file")"
    touch "$log_file" 2>/dev/null
    _pwrfzf_log "--- PWRFZF Started (Version $PWRFZF_VERSION) ---"
  fi
}

function _pwrfzf_log() {
  if [[ "${PWRFZF_LOGGING:-false}" == "true" ]]; then
    local log_file="${PWRFZF_CONFIG_DIR}/pwrfzf.log"
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $1" >> "$log_file"
  fi
}

function _check_dependencies() {
  local deps=("fzf" "eix" "qlist" "qsearch" "portageq")
  local missing=()
  
  for dep in "${deps[@]}"; do
    if ! command -v "$dep" >/dev/null 2>&1; then
      missing+=("$dep")
    fi
  done
  
  if [[ ${#missing[@]} -gt 0 ]]; then
    _pwrfzf_error "Missing dependencies: ${missing[*]}"
    _pwrfzf_warning "Install with: emerge --ask ${missing[*]}"
    exit 1
  fi
}

function _create_directories() {
  local dirs=("$PWRFZF_CACHE_DIR" "$PWRFZF_CONFIG_DIR")
  for dir in "${dirs[@]}"; do
    if [[ ! -d "$dir" ]]; then
      mkdir -p "$dir" 2>/dev/null || {
        _pwrfzf_error "Failed to create directory: $dir"
        exit 1
      }
    fi
  done
  touch "$PWRFZF_HISTORY" "$PWRFZF_INSTALL_LIST" 2>/dev/null
}

function _load_config() {
  # Create default config if entirely missing
  if [[ ! -f "$PWRFZF_CONFIG_FILE" ]]; then
    _create_default_config
  fi
  source "$PWRFZF_CONFIG_FILE" 2>/dev/null || _pwrfzf_warning "Error loading config file. Using defaults."
  
  # Auto-update logic: checks for missing variables and appends them dynamically
  _update_config
}

function _update_config() {
  local updated=false
  local target="$PWRFZF_CONFIG_FILE"

  # Helper function: Checks if a variable exists (even if commented out).
  # If not, the provided block including comments is appended to the bottom.
  _append_if_missing() {
    local var_name="$1"
    local content="$2"
    if ! grep -qE "^[#[:space:]]*${var_name}=" "$target" 2>/dev/null; then
      echo -e "\n$content" >> "$target"
      updated=true
    fi
  }

  _append_if_missing "PWRFZF_CONFIRM_EXIT" "# Confirm before exiting the application\nPWRFZF_CONFIRM_EXIT=true"
  _append_if_missing "PWRFZF_FZF_LAYOUT" "# FZF Layout (reverse = top-down, default = bottom-up)\nPWRFZF_FZF_LAYOUT=\"reverse\""
  _append_if_missing "PWRFZF_EXACT_SEARCH" "# Search Behavior\n# TRUE  = Exact substring match (e.g. 'wine' won't match 'window')\n# FALSE = Fuzzy match (e.g. 'wine' matches 'w..i..n..e')\n# When false you can use 'wine to search for exact name\nPWRFZF_EXACT_SEARCH=true"
  _append_if_missing "PWRFZF_SEARCH_NAMES_ONLY" "# Search Targets\n# TRUE  = Search ONLY in package names (e.g. app-emulation/wine)\n# FALSE = Search in package names AND descriptions\nPWRFZF_SEARCH_NAMES_ONLY=false"
  _append_if_missing "PWRFZF_HISTORY_CMD" "# History / Log Backend (elogv, elogfzf, genlop, qlop, log, auto)\nPWRFZF_HISTORY_CMD=\"elogv\""
  _append_if_missing "PWRFZF_EDITOR" "# Preferred text editor for config files and eLogs\n# (e.g. nvim, nano, vim, kate, gedit). Leave empty to use system default (\$EDITOR).\nPWRFZF_EDITOR=\"\""
  _append_if_missing "PWRFZF_CONFIG_UPDATER" "# Tool used to merge/update configuration files\n# (e.g. cfg-update -u, dispatch-conf, etc-update).\nPWRFZF_CONFIG_UPDATER=\"cfg-update -u\""
  _append_if_missing "PWRFZF_EMERGE_CMD" "# Base emerge command (useful if you use a wrapper script)\nPWRFZF_EMERGE_CMD=\"emerge\""
  _append_if_missing "PWRFZF_COLOR_THEME" "# Custom FZF color theme string. Leave empty for default.\n# Base scheme (dark|light|base16|bw) and/or custom colors\nPWRFZF_COLOR_THEME=\"\""
  _append_if_missing "PWRFZF_GLSA_REVERSE" "# GLSA sorting: true = newest first, false = oldest first\nPWRFZF_GLSA_REVERSE=true"
  _append_if_missing "PWRFZF_USE_DEFAULT_EMERGE_OPTS" "# Emerge behavior\nPWRFZF_USE_DEFAULT_EMERGE_OPTS=false"
  _append_if_missing "PWRFZF_PREVIEW_WINDOW" "# Layout\nPWRFZF_PREVIEW_WINDOW=\"right,60%,border-left\""

  # WORLD UPDATE CONFIGURATION
  _append_if_missing "PWRFZF_UPDATE_LOWER_PRIORITY" "# WORLD UPDATE: Lower process priority (renice/ionice) to keep system responsive\nPWRFZF_UPDATE_LOWER_PRIORITY=true"
  _append_if_missing "PWRFZF_UPDATE_UPDATE_PORTAGE_FIRST" "# WORLD UPDATE: Update sys-apps/portage before @world\nPWRFZF_UPDATE_UPDATE_PORTAGE_FIRST=true"
  _append_if_missing "PWRFZF_UPDATE_PRESERVED_REBUILD" "# WORLD UPDATE: Run @preserved-rebuild after update\nPWRFZF_UPDATE_PRESERVED_REBUILD=true"
  _append_if_missing "PWRFZF_UPDATE_DEPCLEAN" "# WORLD UPDATE: Run emerge --depclean after update\nPWRFZF_UPDATE_DEPCLEAN=true"
  _append_if_missing "PWRFZF_UPDATE_CLEAN_LOGS" "# WORLD UPDATE: Clean portage logs older than 7 days (emaint)\nPWRFZF_UPDATE_CLEAN_LOGS=true"
  _append_if_missing "PWRFZF_UPDATE_ECLEAN_PACKAGES" "# WORLD UPDATE: Run eclean packages\nPWRFZF_UPDATE_ECLEAN_PACKAGES=false"
  _append_if_missing "PWRFZF_UPDATE_ECLEAN_DISTFILES" "# WORLD UPDATE: Run eclean distfiles\nPWRFZF_UPDATE_ECLEAN_DISTFILES=false"
  _append_if_missing "PWRFZF_UPDATE_EIX_UPDATE" "# WORLD UPDATE: Update eix cache at the end\nPWRFZF_UPDATE_EIX_UPDATE=true"

  # ADVANCED KERNEL BUILDER CONFIGURATION (DEVELOPER)
  _append_if_missing "PWRFZF_ENABLE_KERNEL_HUB" "# DEVELOPER: Enable Kernel & Dracut Hub (Ctrl-k) in UI (true/false)\nPWRFZF_ENABLE_KERNEL_HUB=false"
  _append_if_missing "PWRFZF_KERNEL_USE_CUSTOM_INSTALL" "# KERNEL: Enable advanced custom kernel installation routine (true/false)\n# WARNING: Only enable this if you need custom EFI mounting, Dracut, and sbsign!\n# Default is true for this specific system layout. Set to false to use Gentoo's installkernel.\nPWRFZF_KERNEL_USE_CUSTOM_INSTALL=true"
  _append_if_missing "PWRFZF_KERNEL_MAKEOPTS" "# KERNEL: Custom MAKEOPTS (e.g. \"-j32\"). If empty, falls back to make.conf MAKEOPTS\nPWRFZF_KERNEL_MAKEOPTS=\"\""
  _append_if_missing "PWRFZF_KERNEL_COMPILER" "# KERNEL: Compiler selection (gcc or clang)\nPWRFZF_KERNEL_COMPILER=\"gcc\""
  _append_if_missing "PWRFZF_KERNEL_SILENT_MAKE" "# KERNEL: Build the kernel in silent mode (-s)\nPWRFZF_KERNEL_SILENT_MAKE=false"
  _append_if_missing "PWRFZF_KERNEL_USE_CCACHE" "# KERNEL: Use ccache to speed up re-compilation\nPWRFZF_KERNEL_USE_CCACHE=true"
  _append_if_missing "PWRFZF_KERNEL_MAKE_MRPROPER" "# KERNEL: Perform 'make clean && make mrproper' and restore saved .config\nPWRFZF_KERNEL_MAKE_MRPROPER=false"
  _append_if_missing "PWRFZF_KERNEL_USE_DRACUT" "# KERNEL: Enable dracut initrd generation\nPWRFZF_KERNEL_USE_DRACUT=true"
  _append_if_missing "PWRFZF_KERNEL_GUI_TOOL" "# KERNEL: GUI tool to use for configuration (menuconfig, nconfig, xconfig, gconfig)\nPWRFZF_KERNEL_GUI_TOOL=\"xconfig\""
  _append_if_missing "PWRFZF_KERNEL_TARGET_EFI_DIR" "# KERNEL: Target EFI directory name inside /efi/EFI/ (e.g. Gentoo)\nPWRFZF_KERNEL_TARGET_EFI_DIR=\"Gentoo\""
  _append_if_missing "PWRFZF_KERNEL_EFI_PART_LABEL" "# KERNEL: Target boot partition name to match via /dev/disk/by-label/\nPWRFZF_KERNEL_EFI_PART_LABEL=\"EFI\""
  _append_if_missing "PWRFZF_KERNEL_SIGNING_KEY" "# KERNEL: Path to Secure Boot Key. If empty, falls back to make.conf SECUREBOOT_SIGN_KEY\nPWRFZF_KERNEL_SIGNING_KEY=\"/etc/efikeys/sb-keys-2026/db.key\""
  _append_if_missing "PWRFZF_KERNEL_SIGNING_CERT" "# KERNEL: Path to Secure Boot Cert. If empty, falls back to make.conf SECUREBOOT_SIGN_CERT\nPWRFZF_KERNEL_SIGNING_CERT=\"/etc/efikeys/sb-keys-2026/db.crt\""
  _append_if_missing "PWRFZF_KERNEL_LOADEROPTS" "# KERNEL: Command line parameters (loaderopts)\n# Ensure to adapt PARTUUID and parameters to your system!\nPWRFZF_KERNEL_LOADEROPTS=\"root=PARTUUID=77e300af-dd46-451f-ba02-79f0107245cf rootflags=subvol=@ rootfstype=btrfs rd.vconsole.keymap=de-latin1 console=tty1 amdgpu.sg_display=0 quiet splash\""

  if [[ "$updated" == "true" ]]; then
    # Reload config immediately so new variables are active in running script
    source "$target" 2>/dev/null
  fi
}

function _validate_config() {
  if [[ -n "${PRIV_ESC:-}" ]]; then
    if [[ "$PRIV_ESC" != "sudo" && "$PRIV_ESC" != "doas" && "$PRIV_ESC" != "" ]]; then
      _pwrfzf_warning "Invalid PRIV_ESC value: '$PRIV_ESC'. Using auto-detection."
      unset PRIV_ESC
    elif [[ -n "$PRIV_ESC" ]] && ! command -v "$PRIV_ESC" >/dev/null 2>&1; then
      _pwrfzf_warning "Configured PRIV_ESC '$PRIV_ESC' not found in PATH. Using auto-detection."
      unset PRIV_ESC
    fi
  fi
  
  if [[ "${PWRFZF_LOGGING:-false}" != "true" && "${PWRFZF_LOGGING:-false}" != "false" ]]; then
    PWRFZF_LOGGING="false"
  fi

  if [[ "${PWRFZF_CONFIRM_EXIT}" != "true" && "${PWRFZF_CONFIRM_EXIT}" != "false" ]]; then
    PWRFZF_CONFIRM_EXIT="true"
  fi

  if [[ "${PWRFZF_FZF_LAYOUT}" != "reverse" && "${PWRFZF_FZF_LAYOUT}" != "default" && "${PWRFZF_FZF_LAYOUT}" != "reverse-list" ]]; then
    PWRFZF_FZF_LAYOUT="reverse"
  fi
  
  if [[ "${PWRFZF_EXACT_SEARCH}" != "true" && "${PWRFZF_EXACT_SEARCH}" != "false" ]]; then
    PWRFZF_EXACT_SEARCH="true"
  fi
  
  if [[ "${PWRFZF_SEARCH_NAMES_ONLY}" != "true" && "${PWRFZF_SEARCH_NAMES_ONLY}" != "false" ]]; then
    PWRFZF_SEARCH_NAMES_ONLY="false"
  fi

  if [[ "${PWRFZF_GLSA_REVERSE}" != "true" && "${PWRFZF_GLSA_REVERSE}" != "false" ]]; then
    PWRFZF_GLSA_REVERSE="true"
  fi

  if [[ "${PWRFZF_ENABLE_KERNEL_HUB}" != "true" && "${PWRFZF_ENABLE_KERNEL_HUB}" != "false" ]]; then
    PWRFZF_ENABLE_KERNEL_HUB="false"
  fi

  if [[ -z "${PWRFZF_EDITOR:-}" ]]; then
    PWRFZF_EDITOR="${EDITOR:-nvim}"
  fi
  
  if [[ -z "${PWRFZF_EMERGE_CMD:-}" ]]; then
    PWRFZF_EMERGE_CMD="emerge"
  fi
  
  if [[ -z "${PWRFZF_CONFIG_UPDATER:-}" ]]; then
    PWRFZF_CONFIG_UPDATER="cfg-update -u"
  fi

  local fzf_globals="--layout=${PWRFZF_FZF_LAYOUT:-reverse}"
  [[ "${PWRFZF_EXACT_SEARCH:-true}" == "true" ]] && fzf_globals="$fzf_globals --exact"
  
  # Global bindings for scrolling the preview window safely across terminals
  fzf_globals="$fzf_globals --bind 'alt-up:preview-up,alt-down:preview-down,ctrl-up:preview-page-up,ctrl-down:preview-page-down'"
  
  export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:-} $fzf_globals"
}

function _create_default_config() {
  # Creates a massive, fully documented default config on first run
  cat > "$PWRFZF_CONFIG_FILE" << 'EOF'
# PWRFZF Configuration File
# Colors and display
NO_COLOR=false
NO_FX=false

# Behavior
PWRFZF_SHOW_INSTALLED=true
PWRFZF_AUTO_SYNC=false
PWRFZF_CONFIRM_ACTIONS=true
PWRFZF_CONFIRM_EXIT=true
PWRFZF_MAX_PREVIEW_LINES=50
PWRFZF_LOGGING=true

# FZF Layout (reverse = top-down, default = bottom-up)
PWRFZF_FZF_LAYOUT="reverse"

# Search Behavior
# TRUE  = Exact substring match (e.g. 'wine' won't match 'window')
# FALSE = Fuzzy match (e.g. 'wine' matches 'w..i..n..e')
# When false you can use 'wine to search for exact name
PWRFZF_EXACT_SEARCH=true

# Search Targets
# TRUE  = Search ONLY in package names (e.g. app-emulation/wine)
# FALSE = Search in package names AND descriptions
PWRFZF_SEARCH_NAMES_ONLY=false

# History / Log Backend (elogv, elogfzf, genlop, qlop, log, auto)
PWRFZF_HISTORY_CMD="elogv"

# Preferred text editor for config files and eLogs
# (e.g. nvim, nano, vim, kate, gedit). Leave empty to use system default ($EDITOR).
PWRFZF_EDITOR=""

# Tool used to merge/update configuration files
# (e.g. cfg-update -u, dispatch-conf, etc-update).
PWRFZF_CONFIG_UPDATER="cfg-update -u"

# Base emerge command (useful if you use a wrapper script)
PWRFZF_EMERGE_CMD="emerge"

# Custom FZF color theme string. Leave empty for default.
# Base scheme (dark|light|base16|bw) and/or custom colors
PWRFZF_COLOR_THEME=""

# GLSA sorting: true = newest first, false = oldest first
PWRFZF_GLSA_REVERSE=true

# Emerge behavior
PWRFZF_USE_DEFAULT_EMERGE_OPTS=false

# Layout
PWRFZF_PREVIEW_WINDOW="right,60%,border-left"

# Privilege escalation (sudo/doas/empty for root)
PRIV_ESC="sudo"

# ==============================================================================
# WORLD UPDATE CONFIGURATION
# ==============================================================================
# Lower process priority (renice/ionice) to keep system responsive
PWRFZF_UPDATE_LOWER_PRIORITY=true

# Update sys-apps/portage before @world
PWRFZF_UPDATE_UPDATE_PORTAGE_FIRST=true

# Run @preserved-rebuild after update
PWRFZF_UPDATE_PRESERVED_REBUILD=true

# Run emerge --depclean after update
PWRFZF_UPDATE_DEPCLEAN=true

# Clean portage logs older than 7 days (emaint)
PWRFZF_UPDATE_CLEAN_LOGS=true

# Run eclean packages
PWRFZF_UPDATE_ECLEAN_PACKAGES=false

# Run eclean distfiles
PWRFZF_UPDATE_ECLEAN_DISTFILES=false

# Update eix cache at the end
PWRFZF_UPDATE_EIX_UPDATE=true

# ==============================================================================
# ADVANCED DEVELOPER SETTINGS: CUSTOM KERNEL INSTALLER
# ==============================================================================
# WARNING: These settings override the default Gentoo `make install` routine.
# They are designed for highly customized setups involving manual EFI mounts,
# direct efibootmgr manipulation, and Secure Boot signing (sbsign).

# DEVELOPER: Enable Kernel & Dracut Hub (Ctrl-k) in UI (true/false)
PWRFZF_ENABLE_KERNEL_HUB=false

# Enable custom kernel installation routine (true/false)
# Default is true for this specific system layout. Set to false to use Gentoo's installkernel.
PWRFZF_KERNEL_USE_CUSTOM_INSTALL=true

# Custom MAKEOPTS (e.g. "-j32"). If empty, falls back to make.conf MAKEOPTS
PWRFZF_KERNEL_MAKEOPTS=""

# Compiler selection (gcc or clang)
PWRFZF_KERNEL_COMPILER="gcc"

# Build the kernel in silent mode (-s)
PWRFZF_KERNEL_SILENT_MAKE=false

# Use ccache to speed up re-compilation (true/false)
PWRFZF_KERNEL_USE_CCACHE=true

# Perform 'make clean && make mrproper' and restore saved .config
PWRFZF_KERNEL_MAKE_MRPROPER=false

# Enable dracut initrd generation automatically after install (true/false)
PWRFZF_KERNEL_USE_DRACUT=true

# GUI tool to use for configuration (menuconfig, nconfig, xconfig)
PWRFZF_KERNEL_GUI_TOOL="xconfig"

# Target EFI directory name inside /efi/EFI/ (e.g. Gentoo)
PWRFZF_KERNEL_TARGET_EFI_DIR="Gentoo"

# Partition label used to automatically mount the EFI partition
PWRFZF_KERNEL_EFI_PART_LABEL="EFI"

# Path to Secure Boot Key. If empty, falls back to make.conf SECUREBOOT_SIGN_KEY
PWRFZF_KERNEL_SIGNING_KEY="/etc/efikeys/sb-keys-2026/db.key"

# Path to Secure Boot Cert. If empty, falls back to make.conf SECUREBOOT_SIGN_CERT
PWRFZF_KERNEL_SIGNING_CERT="/etc/efikeys/sb-keys-2026/db.crt"

# Kernel command line parameters (loaderopts)
# Ensure to adapt PARTUUID and parameters to your system!
PWRFZF_KERNEL_LOADEROPTS="root=PARTUUID=77e300af-dd46-451f-ba02-79f0107245cf rootflags=subvol=@ rootfstype=btrfs rd.vconsole.keymap=de-latin1 console=tty1 amdgpu.sg_display=0 quiet splash"
EOF
}

function _find_privilege_escalator() {
  if [[ -n "${PRIV_ESC:-}" ]]; then
    _pwrfzf_verbose "Using configured privilege escalator: $PRIV_ESC"
    return
  fi
  
  if [[ $EUID -eq 0 ]]; then
    PRIV_ESC=""
    _pwrfzf_verbose "Running as root, no privilege escalation needed"
    return
  fi
  
  if command -v sudo >/dev/null 2>&1; then
    PRIV_ESC="sudo"
    _pwrfzf_verbose "Auto-detected sudo as privilege escalator"
  elif command -v doas >/dev/null 2>&1; then
    PRIV_ESC="doas"
    _pwrfzf_verbose "Auto-detected doas as privilege escalator"
  else
    _pwrfzf_error "Neither sudo nor doas found. Install one or run as root."
    exit 1
  fi
}

function _set_colors() {
  if [[ "${NO_COLOR:-}" != "true" && "${NO_COLOR:-}" != "1" ]]; then
    if [[ -n "${PWRFZF_COLOR_THEME:-}" ]]; then
      pwrfzf_colortheme="$PWRFZF_COLOR_THEME"
    else
      pwrfzf_colortheme="hl:italic:#FFFF00,hl+:bold:underline:#FF0000,fg:#98A0C5,fg+:bold:underline:#FFFFFF,bg:#13172A,bg+:#0F1222,border:#75A2F7,label:bold:#75A2F7,preview-fg:bold:#C0CAF5,preview-bg:#0F1222,marker:#00FF00,gutter:#0F1222,pointer:#FF0000,query:#FF0000,info:italic:#98A0C5,spinner:#00FFFF,header:italic:#75A2F7"
    fi
    COLOR_WHEN="always"
    pwrfzf_color=(
      [Reset]='\x1B[0m' [Bold]='\x1B[1m' [Italic]='\x1B[3m'
      [Red]='\x1B[38;5;196m' [Green]='\x1B[38;5;46m' [Yellow]='\x1B[38;5;190m'
      [Cyan]='\x1B[38;5;87m' [White]='\x1B[38;5;15m' [Black]='\x1B[38;5;0m'
      [BG_Red]='\x1B[48;5;196m' [BG_Green]='\x1B[48;5;46m'
      [BG_Yellow]='\x1B[48;5;190m' [BG_Blue]='\x1B[48;5;33m'
    )
  else
    pwrfzf_colortheme="fg:#FFFFFF"
    COLOR_WHEN="never"
  fi
}

function _set_fx() {
  if [[ -z "${NO_FX:-}" ]]; then
    pwrfzf_fx=( [Save_Title]='\x1B[22;0t' [Restore_Title]='\x1B[23;0t' )
  fi
}

function _find_emerge() {
  if [[ $EUID -eq 0 ]]; then
    EMERGE_CMD="$PWRFZF_EMERGE_CMD"
  else
    EMERGE_CMD="${PRIV_ESC} $PWRFZF_EMERGE_CMD"
  fi
}

function _load_emerge_default_opts() {
  if [[ -n "${EMERGE_DEFAULT_OPTS:-}" ]]; then 
    _pwrfzf_verbose "Using EMERGE_DEFAULT_OPTS from environment: $EMERGE_DEFAULT_OPTS"
    return
  fi
  
  # Try to safely extract EMERGE_DEFAULT_OPTS via portageq directly
  if command -v portageq >/dev/null 2>&1; then
    local env_opts
    env_opts=$(portageq envvar EMERGE_DEFAULT_OPTS 2>/dev/null)
    if [[ -n "$env_opts" ]]; then
      EMERGE_DEFAULT_OPTS="$env_opts"
      _pwrfzf_verbose "Loaded EMERGE_DEFAULT_OPTS via portageq: $EMERGE_DEFAULT_OPTS"
      return
    fi
  fi
  
  # Fallback manual extraction
  local sourced_opts
  if [[ -f "${PORTAGE_ETC}/make.conf" ]]; then
    sourced_opts=$(source "${PORTAGE_ETC}/make.conf" 2>/dev/null; echo "${EMERGE_DEFAULT_OPTS:-}")
    if [[ -n "$sourced_opts" ]]; then
      EMERGE_DEFAULT_OPTS="$sourced_opts"
      _pwrfzf_verbose "Loaded EMERGE_DEFAULT_OPTS from make.conf: $EMERGE_DEFAULT_OPTS"
      return
    fi
  fi
  
  if [[ -d "${PORTAGE_ETC}/make.conf.d" ]]; then
    for conf_file in "${PORTAGE_ETC}/make.conf.d"/*.conf; do
      [[ -f "$conf_file" ]] || continue
      sourced_opts=$(source "$conf_file" 2>/dev/null; echo "${EMERGE_DEFAULT_OPTS:-}")
      if [[ -n "$sourced_opts" ]]; then
        EMERGE_DEFAULT_OPTS="$sourced_opts"
        _pwrfzf_verbose "Loaded EMERGE_DEFAULT_OPTS from $conf_file: $EMERGE_DEFAULT_OPTS"
        return
      fi
    done
  fi

  if [[ "${PWRFZF_USE_DEFAULT_EMERGE_OPTS:-false}" == "true" ]]; then
    EMERGE_DEFAULT_OPTS="--quiet-build=y --keep-going"
    _pwrfzf_verbose "Using fallback EMERGE_DEFAULT_OPTS: $EMERGE_DEFAULT_OPTS"
  else
    _pwrfzf_verbose "No EMERGE_DEFAULT_OPTS found and fallback disabled"
  fi
}

function _load_layout() {
  if [[ -f "$PWRFZF_LAYOUT_FILE" ]]; then
    PWRFZF_LAYOUT=$(<"$PWRFZF_LAYOUT_FILE")
  fi
}

function _save_layout() {
  echo "$PWRFZF_LAYOUT" > "$PWRFZF_LAYOUT_FILE"
}

# ------------------------------------------------------------------------------
# UI HELPERS & OUTPUT
# ------------------------------------------------------------------------------
function _print_divider() {
  echo "══════════════════════════════════════"
}

# PERFORMANCE BOOST: Cache invalidation handler
function _clear_preview_cache() {
  local cache_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/pwrfzf_cache"
  if [[ -d "$cache_dir" ]]; then
    rm -rf "$cache_dir" 2>/dev/null
  fi
}

# IMPORTANT: All UI functions write to >&2 (stderr) to avoid polluting stdout.
# Stdout is STRICTLY reserved for data pipes used by FZF previews and lists!
function _pwrfzf_error() {
  printf "${pwrfzf_color[Bold]}${pwrfzf_color[BG_Red]}${pwrfzf_color[White]} ERROR ${pwrfzf_color[Reset]}:\t${pwrfzf_color[Italic]}${pwrfzf_color[Red]}%s${pwrfzf_color[Reset]}\n" "$@" >&2
  _pwrfzf_log "ERROR: $*"
}

function _pwrfzf_warning() {
  printf "${pwrfzf_color[Bold]}${pwrfzf_color[BG_Yellow]}${pwrfzf_color[Black]} WARNING ${pwrfzf_color[Reset]}:\t${pwrfzf_color[Italic]}${pwrfzf_color[Yellow]}%s${pwrfzf_color[Reset]}\n" "$@" >&2
  _pwrfzf_log "WARNING: $*"
}

function _pwrfzf_success() {
  printf "${pwrfzf_color[Bold]}${pwrfzf_color[BG_Green]}${pwrfzf_color[Black]} SUCCESS ${pwrfzf_color[Reset]}:\t${pwrfzf_color[Italic]}${pwrfzf_color[Green]}%s${pwrfzf_color[Reset]}\n" "$@" >&2
  _pwrfzf_log "SUCCESS: $*"
}

function _pwrfzf_verbose() {
  # Disabled by default on stdout/stderr to prevent breaking FZF pipelines and TUI corruption.
  if [[ "${PWRFZF_DEBUG:-false}" == "true" ]]; then
    printf "${pwrfzf_color[Bold]}${pwrfzf_color[BG_Blue]}${pwrfzf_color[Yellow]} VERBOSE ${pwrfzf_color[Reset]}:\t${pwrfzf_color[Italic]}${pwrfzf_color[Cyan]}%s${pwrfzf_color[Reset]}\n" "$@" >&2
  fi
  _pwrfzf_log "VERBOSE: $*"
}

function _fzf_viewer() {
  local title="$1"
  fzf --no-sort --ansi \
    --header="$title (Type to search, Enter/ESC to exit)" \
    --border='double' \
    --border-label="┨${PROG} - Viewer┠" \
    --color="${pwrfzf_colortheme}" \
    --bind='enter:abort'
}

function _pwrfzf_keys() {
  local keys_out="KEYBINDINGS:
                 TAB : Select / Multi-Select
           Shift-TAB : Unselect
              Ctrl-i : Toggle current selection
              Ctrl-d : Deselect all
              Ctrl-r : Force uninstall selected (unmerge)
              Ctrl-x : System Depclean (emerge --depclean)
              Ctrl-w : Update all world packages
              Ctrl-z : Run preserved rebuild
              Ctrl-s : Sync repositories
              Ctrl-p : Toggle installed packages only"

  if [[ "${PWRFZF_ENABLE_KERNEL_HUB:-false}" == "true" ]]; then
    keys_out+=$'\n              Ctrl-k : System Hub (Kernel, EFI, Btrfs)'
  fi

  keys_out+=$'
              Ctrl-y : View eLogs / Emerge History
              Ctrl-o : Open Portage Config Manager
              Ctrl-/ : Change layout
              Ctrl-v : Hide/show preview
              Ctrl-l : Clear query
               Alt-u : Run Config Updater ('$PWRFZF_CONFIG_UPDATER')
         Alt-Up/Down : Scroll preview line-by-line
        Ctrl-Up/Down : Scroll preview page-by-page
         Alt-p/Alt-n : Previous/Next Search History
       Alt-backspace : Clear query
            Alt-left : Delete word
              Ctrl-h : Show keybindings
                   ? : Show keybindings
              Ctrl-q : Exit
                 ESC : Exit'
                 
  echo "$keys_out"
}

