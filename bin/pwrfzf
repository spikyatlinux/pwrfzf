  _pwrfzf_help
  cat >&2 <<EOF
EXAMPLES:
  $ $PROG             : Run $PROG with no search query
  $ $PROG fzf         : Search for 'fzf'
  $ $PROG -c          : Manage Portage configuration
$(_pwrfzf_keys)
EOF
}

function _pwrfzf_version() {
  echo "${PROG}: ${PWRFZF_VERSION}"
}

# ------------------------------------------------------------------------------
# PORTAGE SEARCH & PREVIEW
# ------------------------------------------------------------------------------
function __emerge_list() {
  if [[ "${PWRFZF_FZF_LAYOUT}" == "reverse" ]]; then
    qsearch --all | sort | grep -E "${1:-.*}"
  else
    qsearch --all | sort -r | grep -E "${1:-.*}"
  fi
}

function _toggle_installed() {
  local layout="$1"
  local flag_file="${PWRFZF_CACHE_DIR}/.show_installed"
  
  if [[ -f "$flag_file" ]]; then
    rm -f "$flag_file"
    if [[ "$layout" == "reverse" ]]; then
      qsearch --all | sort
    else
      qsearch --all | sort -r
    fi
  else
    touch "$flag_file"
    if [[ "$layout" == "reverse" ]]; then
      qlist -I | sort
    else
      qlist -I | sort -r
    fi
  fi
}

function __fzf_preview() {
  # PERFORMANCE BOOST: Prevent zombie processes on fast scrolling by killing process group
  trap 'trap - TERM; kill 0' INT TERM EXIT
  
  local package_name="${1%%:*}"
  [[ -z "$package_name" ]] && return
  
  # PERFORMANCE BOOST: Tmpfs RAM Caching for instant scrolling
  local safe_pkg="${package_name//\//_}"
  local cache_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}/pwrfzf_cache"
  local cache_file="$cache_dir/$safe_pkg"

  [[ ! -d "$cache_dir" ]] && mkdir -p "$cache_dir" 2>/dev/null

  # Cache Hit - exec replaces the shell immediately
  if [[ -f "$cache_file" ]]; then
    exec cat "$cache_file"
  fi

  # Cache Miss - Generate and save to RAM via tee
  {
    eix "$package_name" 2>/dev/null
    
    if command -v equery >/dev/null 2>&1; then
      echo
      echo "════════════════════════════════════════════════════════════════════════════════"
      echo "USE FLAGS (equery):"
      # Suppress verbose legend and standard output noise from equery uses
      equery uses "$package_name" 2>/dev/null | grep -v '\[ Legend :' | grep -v '^ *U - ' | grep -v '^ *I - ' | grep -v '^[[:space:]]*$'
    fi
    
    echo
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo "PORTAGE CONFIGURATION:"
    
    for config_type in accept_keywords env mask unmask use; do
      local config_file="${PORTAGE_ETC}/package.$config_type"
      if [[ -e "$config_file" ]]; then
        local config_content
        config_content=$(grep -r "$package_name" "$config_file" 2>/dev/null | head -5)
        if [[ -n "$config_content" ]]; then
          echo
          echo "package.$config_type:"
          echo "$config_content"
        fi
      fi
    done
    
    echo
    echo "════════════════════════════════════════════════════════════════════════════════"
    echo "INSTALLED FILES:"
    qlist "$package_name" 2>/dev/null | head -20
  } | tee "$cache_file" 2>/dev/null
}

# ------------------------------------------------------------------------------
# SYSTEM UPDATER
# ------------------------------------------------------------------------------
function _run_config_updater() {
  local updater="${PWRFZF_CONFIG_UPDATER:-cfg-update -u}"
  # Extract just the binary name (e.g., 'cfg-update' from 'cfg-update -u') to check if it exists
  local updater_cmd="${updater%% *}"
  
  _print_divider
  echo "Running Configuration Updater: $updater"
  _print_divider
  
  if command -v "$updater_cmd" >/dev/null 2>&1; then
    # Unquoted execution so arguments like '-u' are correctly passed to the shell.
    # We pipe /dev/tty so interactive tools don't crash when launched from FZF subshells.
    if [[ $EUID -eq 0 ]]; then
      $updater < /dev/tty
    else
      ${PRIV_ESC} $updater < /dev/tty
    fi
    echo
    read -n1 -rsp "Press any key to return..." < /dev/tty
    
    # PERFORMANCE BOOST: Config updated, purge cache
    _clear_preview_cache
  else
    _pwrfzf_error "Updater '$updater_cmd' not found. Please install it or change PWRFZF_CONFIG_UPDATER in pwrfzf.conf"
    read -n1 -s < /dev/tty
  fi
}

function _launch_editor() {
  local file_path="$1"
  local editor="${PWRFZF_EDITOR:-}"
  local editor_cmd="${editor%% *}"
  
  # If the configured editor doesn't exist, fallback to robust detection
  if ! command -v "$editor_cmd" >/dev/null 2>&1; then
    if command -v nvim >/dev/null 2>&1; then editor="nvim"
    elif command -v nano >/dev/null 2>&1; then editor="nano"
    elif command -v vim >/dev/null 2>&1; then editor="vim"
    elif command -v vi >/dev/null 2>&1; then editor="vi"
    elif command -v gedit >/dev/null 2>&1; then editor="gedit"
    elif command -v kate >/dev/null 2>&1; then editor="kate"
    elif command -v leafpad >/dev/null 2>&1; then editor="leafpad"
    else
      _pwrfzf_error "No editor found! Please install nvim, nano, vim, or configure PWRFZF_EDITOR."
      return 1
    fi
  fi
  
  if [[ ! -f "$file_path" ]]; then
    ${PRIV_ESC} mkdir -p "$(dirname "$file_path")"
    ${PRIV_ESC} touch "$file_path"
  fi
  
  # Launch directly. GUI editors handle this natively without breaking the terminal.
  if [[ $EUID -eq 0 ]]; then
    $editor "$file_path" < /dev/tty
  else
    ${PRIV_ESC} $editor "$file_path" < /dev/tty
  fi
  
  # PERFORMANCE BOOST: Ensure preview cache is cleared after config file changes
  _clear_preview_cache
  tput reset 2>/dev/null || true
  stty sane
}

# ------------------------------------------------------------------------------
# SYSTEM & KERNEL HUB (Advanced Configurable Builder, Bootmgr & Btrfs)
# ------------------------------------------------------------------------------
function _kernel_hub() {
  local kernel_src_dir="${PWRFZF_KERNEL_DIR:-/usr/src/linux}"
  local kernel_bck_dir="${PWRFZF_KERNEL_BCK_DIR:-/etc/kernel}"
  
  local kernel_missing=false
  if ! ${PRIV_ESC} test -d "$kernel_src_dir"; then
    kernel_missing=true
  fi

  while true; do
    tput clear 2>/dev/null || clear
    _print_divider
    echo "🐧 SYSTEM & KERNEL HUB (Developer)"
    _print_divider
    
    if [[ "$kernel_missing" == "false" ]]; then
      local active_kernel src_version
      active_kernel=$(uname -r)
      src_version=$(${PRIV_ESC} make -C "$kernel_src_dir" -s kernelrelease 2>/dev/null || echo "Unknown")

      echo "Running Kernel: $active_kernel"
      echo "Source  Kernel: $src_version ($kernel_src_dir)"
      
      if [[ "$active_kernel" != "$src_version" ]]; then
        echo -e "\n⚠️  ${pwrfzf_color[Yellow]}Version mismatch detected! A new kernel might be waiting to be built.${pwrfzf_color[Reset]}"
      fi
      
      if [[ "${PWRFZF_KERNEL_USE_CUSTOM_INSTALL:-false}" == "true" ]]; then
        echo -e "\n🔧 ${pwrfzf_color[Cyan]}Advanced Custom Kernel Installer enabled (Check pwrfzf.conf).${pwrfzf_color[Reset]}"
      else
        echo -e "\n📦 ${pwrfzf_color[Green]}Standard sys-kernel/installkernel hooks enabled.${pwrfzf_color[Reset]}"
      fi
    else
      echo -e "\n⚠️  ${pwrfzf_color[Yellow]}Kernel source directory not found at: $kernel_src_dir${pwrfzf_color[Reset]}"
      echo -e "📦 Kernel compilation features are unavailable.\n"
    fi

    echo
    local gui_tool="${PWRFZF_KERNEL_GUI_TOOL:-xconfig}"
    local action
    action=$(echo -e "─── KERNEL MANAGEMENT ───\n1. 📥 Extract .config from running system (zcat)\n2. ⚙️  Run 'make olddefconfig'\n3. 🛠️  Configure Kernel (${gui_tool})\n4. 🚀 Compile and Install Kernel\n5. 📦 Rebuild Out-Of-Tree Modules (@module-rebuild)\n─── BOOT & SYSTEM ───\n6. 🥾 EFI Boot Manager (efibootmgr menu)\n7. 📸 Btrfs Snapshot Rollback\n8. Back" | fzf \
      --prompt="System Action> " \
      --border='double' \
      --border-label="┨ System Hub ┠" \
      --color="${pwrfzf_colortheme}")

    case "$action" in
      *Extract*.config*)
        if [[ "$kernel_missing" == "true" ]]; then _pwrfzf_error "Kernel source not found!"; read -n1 -s < /dev/tty; continue; fi
        tput clear 2>/dev/null || clear
        _print_divider
        echo "Extracting kernel config from running system..."
        _print_divider
        if ${PRIV_ESC} test -f "$kernel_src_dir/.config"; then
          read -rp "A .config already exists in $kernel_src_dir. Overwrite? (y/N) " overwrite < /dev/tty
          if [[ ! "${overwrite,,}" =~ ^y(es)?$ ]]; then
            echo "Cancelled."
            read -n1 -rsp "Press any key..." < /dev/tty
            continue
          fi
        fi
        if ${PRIV_ESC} test -f /proc/config.gz; then
          ${PRIV_ESC} bash -c "zcat /proc/config.gz > $kernel_src_dir/.config"
          _pwrfzf_success "Config successfully extracted to $kernel_src_dir/.config"
        else
          _pwrfzf_error "/proc/config.gz not found! Ensure IKCONFIG_PROC is enabled in the active kernel."
        fi
        read -n1 -rsp "Press any key..." < /dev/tty
        ;;
      *olddefconfig*)
        if [[ "$kernel_missing" == "true" ]]; then _pwrfzf_error "Kernel source not found!"; read -n1 -s < /dev/tty; continue; fi
        tput clear 2>/dev/null || clear
        echo "Running make olddefconfig..."
        
        # Universal fallback if .config is missing
        if ! ${PRIV_ESC} test -f "$kernel_src_dir/.config"; then
           if [[ "${PWRFZF_KERNEL_USE_CUSTOM_INSTALL:-false}" == "true" ]] && ${PRIV_ESC} test -f "$kernel_bck_dir/kernel-config-$src_version"; then
             echo "Restoring saved config from backup: $kernel_bck_dir/kernel-config-$src_version..."
             ${PRIV_ESC} cp -v "$kernel_bck_dir/kernel-config-$src_version" "$kernel_src_dir/.config"
           else
             echo "No .config found in source dir. Extracting config from running system..."
             if ${PRIV_ESC} test -f /proc/config.gz; then
               ${PRIV_ESC} bash -c "zcat /proc/config.gz > $kernel_src_dir/.config"
               echo "✅ Extracted successfully."
             else
               _pwrfzf_warning "/proc/config.gz not found. make olddefconfig may use defaults."
             fi
           fi
        fi
        
        ${PRIV_ESC} make -C "$kernel_src_dir" olddefconfig < /dev/tty
        read -n1 -rsp "Press any key..." < /dev/tty
        ;;
      *Configure*)
        if [[ "$kernel_missing" == "true" ]]; then _pwrfzf_error "Kernel source not found!"; read -n1 -s < /dev/tty; continue; fi
        tput clear 2>/dev/null || clear
        echo "Launching $gui_tool (Preserving X11/Wayland display environment)..."
        if [[ $EUID -eq 0 ]]; then
          make -C "$kernel_src_dir" "$gui_tool" < /dev/tty
        else
          ${PRIV_ESC} env DISPLAY="${DISPLAY:-:0}" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$UID}" make -C "$kernel_src_dir" "$gui_tool" < /dev/tty
        fi
        read -n1 -rsp "Press any key..." < /dev/tty
        ;;
      *Compile*Install*)
        if [[ "$kernel_missing" == "true" ]]; then _pwrfzf_error "Kernel source not found!"; read -n1 -s < /dev/tty; continue; fi
        tput clear 2>/dev/null || clear
        if [[ "${PWRFZF_KERNEL_USE_CUSTOM_INSTALL:-false}" == "true" ]]; then
          _custom_kernel_install_routine "$kernel_src_dir" "$src_version" "$kernel_bck_dir"
        else
          _standard_kernel_install_routine "$kernel_src_dir"
        fi
        ;;
      *module-rebuild*)
        if [[ "$kernel_missing" == "true" ]]; then _pwrfzf_error "Kernel source not found!"; read -n1 -s < /dev/tty; continue; fi
        tput clear 2>/dev/null || clear
        echo "Rebuilding out-of-tree modules..."
        ${EMERGE_CMD} -1O @module-rebuild < /dev/tty
        ${PRIV_ESC} sync
        read -n1 -rsp "Press any key..." < /dev/tty
        ;;
      *EFI*Boot*Manager*)
        _efibootmgr_menu
        ;;
      *Btrfs*Snapshot*)
        _btrfs_snapshot_menu
        ;;
      *Back*|"")
        break
        ;;
      *)
        continue
        ;;
    esac
  done
}

function _standard_kernel_install_routine() {
  local kernel_src_dir="$1"
  local make_opts="${PWRFZF_KERNEL_MAKEOPTS:-}"
  
  if [[ -z "$make_opts" ]]; then
    if command -v portageq >/dev/null 2>&1; then
      make_opts=$(portageq envvar MAKEOPTS 2>/dev/null)
    else
      make_opts=$(${PRIV_ESC} grep -E '^[[:space:]]*MAKEOPTS=' "${PORTAGE_ETC}/make.conf" 2>/dev/null | cut -d'=' -f2- | tr -d '"'\''')
    fi
  fi

  _print_divider
  echo "Starting Standard Gentoo Kernel Compilation..."
  echo "Using MAKEOPTS: ${make_opts:-Default}"
  _print_divider
  
  local t_start=$(date +%s)

  if ${PRIV_ESC} bash -c "cd $kernel_src_dir && make $make_opts && make $make_opts modules_install && make install"; then
     local t_end=$(date +%s)
     local t_total=$((t_end - t_start))
     echo "================================================="
     echo "Kernel build completed in: $((t_total / 60)) minutes and $((t_total % 60)) seconds."
     echo "================================================="
     _pwrfzf_success "Kernel installed successfully!"
     echo "Note: sys-kernel/installkernel handled initramfs and bootloader."
  else
     _pwrfzf_error "Kernel compilation or installation failed."
  fi
  
  echo
  read -rp "Do you want to rebuild out-of-tree modules (@module-rebuild) now? (y/N) " reb_ans < /dev/tty
  if [[ "${reb_ans,,}" == "y" || "${reb_ans,,}" == "yes" ]]; then
     echo "Rebuilding modules..."
     ${EMERGE_CMD} -1O @module-rebuild < /dev/tty
     ${PRIV_ESC} sync
     _pwrfzf_success "Module rebuild complete."
  fi
  echo
  read -n1 -rsp "Press any key..." < /dev/tty
}

function _custom_kernel_install_routine() {
  local kernel_src_dir="$1"
  local src_version="$2"
  local kernel_bck_dir="$3"
  
  # Matching EXACTLY the original script variables
  local NEW=$(${PRIV_ESC} make -C "$kernel_src_dir" -s kernelversion 2>/dev/null || echo "")
  local NEW_RELEASE=$(${PRIV_ESC} make -C "$kernel_src_dir" -s kernelrelease 2>/dev/null || echo "")
  
  _print_divider
  echo "Starting ADVANCED Custom Kernel Compilation ($NEW_RELEASE)..."
  _print_divider

  local compiler="${PWRFZF_KERNEL_COMPILER:-gcc}"
  local cc_prefix=""
  local llvm_var=""
  
  local make_opts="${PWRFZF_KERNEL_MAKEOPTS:-}"
  if [[ -z "$make_opts" ]]; then
    if command -v portageq >/dev/null 2>&1; then
      make_opts=$(portageq envvar MAKEOPTS 2>/dev/null)
    else
      make_opts=$(${PRIV_ESC} grep -E '^[[:space:]]*MAKEOPTS=' "${PORTAGE_ETC}/make.conf" 2>/dev/null | cut -d'=' -f2- | tr -d '"'\''')
    fi
  fi
  
  if [[ "${PWRFZF_KERNEL_SILENT_MAKE:-false}" == "true" ]]; then
    make_opts="$make_opts -s"
  fi
  
  echo ">> Using MAKEOPTS: ${make_opts:-Default}"
  
  if [[ "${PWRFZF_KERNEL_USE_CCACHE:-false}" == "true" ]] && command -v ccache >/dev/null 2>&1; then
    cc_prefix="ccache "
    echo ">> ccache enabled."
  fi

  if [[ "$compiler" == "clang" ]]; then
    echo ">> Using Clang compiler."
    export CC="${cc_prefix}clang"
    export LD=ld.lld AR=llvm-ar NM=llvm-nm STRIP=llvm-strip
    llvm_var="LLVM=1 LLVM_IAS=1"
    
    echo ">> Setting FRAME_WARN to 4096 for Clang..."
    ${PRIV_ESC} bash -c "cd $kernel_src_dir && scripts/config --set-val FRAME_WARN 4096"
  else
    echo ">> Using GCC compiler."
    export CC="${cc_prefix}gcc"
    unset LD AR NM STRIP
  fi

  if [[ "${PWRFZF_KERNEL_MAKE_MRPROPER:-false}" == "true" ]]; then
    echo ">> Running make clean && make mrproper while saving and restoring .config."
    ${PRIV_ESC} bash -c "
      if [ -f $kernel_src_dir/.config ]; then
          mv $kernel_src_dir/.config $kernel_src_dir/.config.save
          make $make_opts $llvm_var clean && make $make_opts $llvm_var mrproper
          mv $kernel_src_dir/.config.save $kernel_src_dir/.config
      fi
    "
  fi

  # Backup old config
  if ${PRIV_ESC} test -f "$kernel_src_dir/.config"; then
     ${PRIV_ESC} mkdir -p "$kernel_bck_dir"
     ${PRIV_ESC} cp "$kernel_src_dir/.config" "$kernel_bck_dir/kernel-config-$NEW_RELEASE-$(date +%d.%m.%Y-%H%M%S)" 2>/dev/null || true
  fi

  # 1. Mount EFI (Original User Logic with Label)
  local efi_label="${PWRFZF_KERNEL_EFI_PART_LABEL:-EFI}"
  
  if ! ${PRIV_ESC} test -d /efi; then
    ${PRIV_ESC} mkdir -p /efi
    if ${PRIV_ESC} mount -L "$efi_label" /efi; then
      echo ">> Mounted EFI partition ($efi_label) to /efi."
    else
      _pwrfzf_error "Failed to mount EFI partition $efi_label."
      return 1
    fi
  fi

  local t_start=$(date +%s)

  # 2. Compile Kernel
  echo ">> Compiling kernel..."
  if ! ${PRIV_ESC} bash -c "cd $kernel_src_dir && make $make_opts $llvm_var"; then
     _pwrfzf_error "Kernel compilation failed."
     return 1
  fi

  # 3. Clean old modules and install new ones
  echo ">> Cleaning old modules and installing new ones..."
  ${PRIV_ESC} bash -c "
    if [ -d /lib/modules/$NEW_RELEASE ]; then
      find /lib/modules/$NEW_RELEASE -type d -exec rm -rf {} + 2>/dev/null || true
    fi
    cd $kernel_src_dir && unset INSTALL_PATH && make $make_opts $llvm_var modules_install
  "
  
  # AUTO MODULE REBUILD (Before EFI rotation, just in case)
  echo ">> Rebuilding out-of-tree modules (@module-rebuild)..."
  ${EMERGE_CMD} -1O @module-rebuild < /dev/tty

  # 4. Prepare EFI Target
  local target_efi_dir="${PWRFZF_KERNEL_TARGET_EFI_DIR:-Gentoo}"
  local target_path="/efi/EFI/$target_efi_dir"
  ${PRIV_ESC} mkdir -p "$target_path"
  
  # Remove old EFI kernel files matching $NEW
  ${PRIV_ESC} bash -c "find $target_path -type f -name \"*$NEW*\" -delete 2>/dev/null || true"
  ${PRIV_ESC} cp "$kernel_src_dir/arch/x86/boot/bzImage" "$target_path/vmlinuz-$NEW"

  # 5. Dracut Initramfs
  local base_loaderopts="${PWRFZF_KERNEL_LOADEROPTS:-}"
  local final_loaderopts="$base_loaderopts"
  if [[ "${PWRFZF_KERNEL_USE_DRACUT:-false}" == "true" ]]; then
    echo ">> Generating initramfs-${NEW}.img with dracut..."
    if ${PRIV_ESC} dracut --force --hostonly --install "/lib/firmware/regulatory.db /lib/firmware/regulatory.db.p7s" "$target_path/initramfs-${NEW}.img" "$NEW_RELEASE" < /dev/tty; then
      final_loaderopts="initrd=\\EFI\\$target_efi_dir\\initramfs-${NEW}.img $base_loaderopts"
    else
      _pwrfzf_error "Dracut failed."
      return 1
    fi
  fi

  # 6. Secure Boot Signing
  echo ">> Signing kernel for Secure Boot..."
  local sign_key="${PWRFZF_KERNEL_SIGNING_KEY:-}"
  local sign_cert="${PWRFZF_KERNEL_SIGNING_CERT:-}"
  
  # Fallback to make.conf if not set in config OR if file doesn't exist
  if [[ -z "$sign_key" ]] || ! ${PRIV_ESC} test -f "$sign_key"; then
    sign_key=$(${PRIV_ESC} grep '^SECUREBOOT_SIGN_KEY=' /etc/portage/make.conf 2>/dev/null | cut -d'=' -f2 | tr -d '\"')
  fi
  if [[ -z "$sign_cert" ]] || ! ${PRIV_ESC} test -f "$sign_cert"; then
    sign_cert=$(${PRIV_ESC} grep '^SECUREBOOT_SIGN_CERT=' /etc/portage/make.conf 2>/dev/null | cut -d'=' -f2 | tr -d '\"')
  fi
  
  if [[ -n "$sign_key" && -n "$sign_cert" ]] && ${PRIV_ESC} test -f "$sign_key" && ${PRIV_ESC} test -f "$sign_cert"; then
    if ${PRIV_ESC} sbsign --key "$sign_key" --cert "$sign_cert" --output "$target_path/vmlinuz-signed-${NEW}.efi" "$target_path/vmlinuz-${NEW}"; then
      ${PRIV_ESC} mv -f "$target_path/vmlinuz-signed-${NEW}.efi" "$target_path/vmlinuz-${NEW}.efi"
      ${PRIV_ESC} rm -f "$target_path/vmlinuz-${NEW}"
      echo ">> Kernel signed successfully."
    else
      _pwrfzf_error "sbsign failed. Ensure app-crypt/sbsigntools is installed."
      return 1
    fi
  else
    _pwrfzf_warning "Secure Boot keys not found or invalid path. Skipping signing."
    ${PRIV_ESC} mv -f "$target_path/vmlinuz-${NEW}" "$target_path/vmlinuz-${NEW}.efi"
  fi

  # 7. EFI Bootmgr Rotation (Exact Original Logic via temporary execution script)
  if command -v efibootmgr >/dev/null 2>&1; then
    echo ">> Updating efibootmgr..."
    
    local efi_disk="/dev/sda"
    local efi_part="1"
    # Fallback disk detection if needed, but original used by-label
    local efi_detected
    efi_detected=$(${PRIV_ESC} lsblk -o PKNAME,NAME,LABEL -r 2>/dev/null | awk -v lbl="$efi_label" '$3 == lbl {print $0; exit}')
    if [[ -n "$efi_detected" ]]; then
        local pk=$(echo "$efi_detected" | awk '{print $1}')
        local nm=$(echo "$efi_detected" | awk '{print $2}')
        if [[ "$pk" == "$nm" || -z "$pk" ]]; then
            pk=$(echo "$nm" | sed 's/[0-9]*$//') 
            pk=${pk%p} 
        fi
        efi_disk="/dev/$pk"
        efi_part="${nm##*[a-zA-Z]}" 
    fi

    local efi_script="/tmp/pwrfzf_efi_update_$$.sh"
    cat << EOF > "$efi_script"
#!/bin/bash
TARGET_EFI_DIR="$target_efi_dir"
NEW="$NEW"
EFI_PARTITION_LABEL="$efi_label"
LOADEROPTS="$base_loaderopts"
FINAL_LOADEROPTS="$final_loaderopts"
EOF
    cat << 'EOF' >> "$efi_script"
# 1. PLATZ MACHEN: Den alten Slot 0000 zwingend leeren!
efibootmgr -b 0000 -B > /dev/null 2>&1 || true

# 2. AUFRÄUMEN: Lösche alte Fehlschläge des NEUEN Kernels
BOOT_IDS=$(efibootmgr | grep "${TARGET_EFI_DIR}-${NEW}" | awk '{print $1}' | sed 's/Boot\(.*\)\*/\1/')
for b in $BOOT_IDS; do
    efibootmgr -b "$b" -B > /dev/null 2>&1
done

# 3. NEUEN Kernel schreiben (MIT -I 0)
efibootmgr -c -d "/dev/disk/by-label/${EFI_PARTITION_LABEL}" -p 1 -L "${TARGET_EFI_DIR}-${NEW}" -l "\\EFI\\${TARGET_EFI_DIR}\\vmlinuz-${NEW}.efi" -I 0 -u " ${FINAL_LOADEROPTS}" > /dev/null

# 4. JETZT ERST Backup erstellen
OLD_EFI=$(ls -1t /efi/EFI/${TARGET_EFI_DIR}/vmlinuz-*.efi 2>/dev/null | grep -v "${NEW}" | head -n 1)
if [[ -n "$OLD_EFI" ]]; then 
    CLEAN_NAME=$(basename "$OLD_EFI" | sed 's/vmlinuz-//;s/\.efi//')
    FINAL_LABEL="${TARGET_EFI_DIR}-${CLEAN_NAME}"
    
    # AUFRÄUMEN (löscht alte Backups)
    BOOT_IDS=$(efibootmgr | grep "${FINAL_LABEL}" | awk '{print $1}' | sed 's/Boot\(.*\)\*/\1/')
    for b in $BOOT_IDS; do
        efibootmgr -b "$b" -B > /dev/null 2>&1
    done
    
    OLD_LOADEROPTS="initrd=\\EFI\\${TARGET_EFI_DIR}\\initramfs-${CLEAN_NAME}.img ${LOADEROPTS}"
    efibootmgr -c -d "/dev/disk/by-label/${EFI_PARTITION_LABEL}" -p 1 -L "${FINAL_LABEL}" -l "\\EFI\\${TARGET_EFI_DIR}\\vmlinuz-${CLEAN_NAME}.efi" -u " $OLD_LOADEROPTS" > /dev/null
fi

# FINALER SORTIER-SCHRITT
ORDER=$(efibootmgr | awk -F'*' '/Boot[0-9A-F]{4}/ {
    gsub(/.*Boot/, "", $1)
    id = $1
    sub(/^0+/, "", id)
    if (id == "") id = "0"
    printf "%s%s", (c++ ? "," : ""), id
}')
efibootmgr -uo "$ORDER" > /dev/null
EOF
    ${PRIV_ESC} chmod +x "$efi_script"
    ${PRIV_ESC} "$efi_script"
    ${PRIV_ESC} rm -f "$efi_script"
  fi

  local t_end=$(date +%s)
  local t_total=$((t_end - t_start))
  echo "================================================="
  echo "Kernel build completed in: $((t_total / 60)) minutes and $((t_total % 60)) seconds."
  echo "================================================="
  _pwrfzf_success "Advanced Kernel Installation complete."
  echo
  read -n1 -rsp "Press any key..." < /dev/tty
}

# ------------------------------------------------------------------------------
# EFIBOOTMGR MENU (Sub-Menu of Kernel Hub)
# ------------------------------------------------------------------------------
function _efibootmgr_menu() {
  if ! command -v efibootmgr >/dev/null 2>&1; then
    _pwrfzf_error "efibootmgr not found."
    read -n1 -s < /dev/tty
    return
  fi

  while true; do
    tput clear 2>/dev/null || clear
    _print_divider
    echo "🥾 EFI BOOT MANAGER"
    _print_divider
    ${PRIV_ESC} efibootmgr | head -n 3
    echo

    local action
    action=$(echo -e "1. 👁️  View Full Details (efibootmgr -u)\n2. 🔄 Change Boot Order\n3. ➕ Create New Entry\n4. 📝 Edit / Move Entry (Change ID/Params)\n5. 👯 Clone / Backup Entry\n6. 🗑️  Delete Entry\n7. Back" | fzf \
      --prompt="EFI Action> " --border='double' --border-label="┨ EFIBOOTMGR ┠" --color="${pwrfzf_colortheme}")

    case "$action" in
      *View*)
        ${PRIV_ESC} efibootmgr -u | _fzf_viewer "EFI Boot Entries"
        ;;
      *Change*Order*)
        local current_order
        current_order=$(${PRIV_ESC} efibootmgr | grep "^BootOrder:" | awk '{print $2}')
        echo "Current BootOrder: $current_order"
        local new_order
        # Fix: Read with -r prevents backslash escaping and empty entry aborts menu
        read -r -e -i "$current_order" -p "New BootOrder (Clear & Enter to abort): " new_order < /dev/tty
        if [[ -n "$new_order" && "$new_order" != "$current_order" ]]; then
          ${PRIV_ESC} efibootmgr -o "$new_order" >/dev/null
          _pwrfzf_success "BootOrder updated."
          read -n1 -rsp "Press any key..." < /dev/tty
        fi
        ;;
      *Create*)
        _efi_create_edit_entry "create" ""
        ;;
      *Edit*Move*)
        local selected
        selected=$(${PRIV_ESC} efibootmgr | grep "^Boot[0-9]" | fzf --prompt="Select Entry to Edit/Move> " --border='double' --color="${pwrfzf_colortheme}")
        if [[ -n "$selected" ]]; then
           local old_id=$(echo "$selected" | grep -oE "^Boot[0-9A-F]*" | sed 's/Boot//')
           _efi_create_edit_entry "edit" "$old_id"
        fi
        ;;
      *Clone*)
        local selected
        selected=$(${PRIV_ESC} efibootmgr | grep "^Boot[0-9]" | fzf --prompt="Select Entry to Backup> " --border='double' --color="${pwrfzf_colortheme}")
        if [[ -n "$selected" ]]; then
           local old_id=$(echo "$selected" | grep -oE "^Boot[0-9A-F]*" | sed 's/Boot//')
           _efi_create_edit_entry "clone" "$old_id"
        fi
        ;;
      *Delete*)
        local selected
        selected=$(${PRIV_ESC} efibootmgr | grep "^Boot[0-9]" | fzf --multi --prompt="Select Entries to Delete> " --border='double' --color="${pwrfzf_colortheme}")
        if [[ -n "$selected" ]]; then
           echo "$selected" | while read -r line; do
              local del_id=$(echo "$line" | grep -oE "^Boot[0-9A-F]*" | sed 's/Boot//')
              echo "Deleting Boot$del_id..."
              ${PRIV_ESC} efibootmgr -b "$del_id" -B >/dev/null 2>&1
           done
           _pwrfzf_success "Deletion complete."
           read -n1 -rsp "Press any key..." < /dev/tty
        fi
        ;;
      *Back*|"")
        break
        ;;
    esac
  done
}

function _efi_create_edit_entry() {
  local mode="$1" # "create", "edit", "clone"
  local old_id="$2"

  local efi_disk="/dev/sda"
  local efi_part="1"
  local efi_label="Gentoo"
  local efi_loader="/EFI/Gentoo/vmlinuz.efi"
  local efi_opts=""
  local efi_id="auto"

  # Only populate default boot options on a completely new creation
  if [[ "$mode" == "create" ]]; then
     efi_opts="${PWRFZF_KERNEL_LOADEROPTS:-}"
  fi

  # Dynamic disk/part detection for defaults based on lsblk (supports NVMe)
  local efi_detected
  efi_detected=$(${PRIV_ESC} lsblk -o PKNAME,NAME,LABEL -r 2>/dev/null | awk -v lbl="${PWRFZF_KERNEL_EFI_PART_LABEL:-EFI}" '$3 == lbl {print $0; exit}')
  if [[ -n "$efi_detected" ]]; then
      local pk=$(echo "$efi_detected" | awk '{print $1}')
      local nm=$(echo "$efi_detected" | awk '{print $2}')
      if [[ "$pk" == "$nm" || -z "$pk" ]]; then
          pk=$(echo "$nm" | sed 's/[0-9]*$//') 
          pk=${pk%p} 
      fi
      efi_disk="/dev/$pk"
      efi_part="${nm##*[a-zA-Z]}" 
  fi

  if [[ -n "$old_id" ]]; then
      local raw_entry
      # SAFE REGEX EXTRACTION: We completely bypass Bash Regex matching to avoid syntax errors
      raw_entry=$(${PRIV_ESC} efibootmgr -u | grep -E "^Boot${old_id}\*?\b")
      if [[ -n "$raw_entry" ]]; then
          local ext_label ext_loader ext_opts ext_part
          
          # Safely use printf to prevent Bash from interpreting backslashes (\E) as Escape sequences!
          ext_label=$(printf "%s\n" "$raw_entry" | sed -E 's/^Boot[0-9A-F]+\*?[[:space:]]+//' | sed -E 's/[[:space:]]+(HD|PciRoot|BBS|VenHw|Fv|VenMsg|Ctrl)\(.*//')
          
          # Extract the File/FilePath part safely by cutting everything until the closing parenthesis
          local ext_loader_opts
          ext_loader_opts=$(printf "%s\n" "$raw_entry" | sed 's/.*)[/\\]/\//')
          
          ext_loader=$(printf "%s\n" "$ext_loader_opts" | awk '{print $1}')
          
          # Clean trailing windows UTF-16 garbage after .efi
          ext_loader=$(printf "%s\n" "$ext_loader" | sed -E 's/(\.efi|\.EFI).*/\1/i')
          
          # Options are everything after the first space. If no space exists, it will be safely empty.
          ext_opts=$(printf "%s\n" "$ext_loader_opts" | awk '{$1=""; print $0}' | sed -E 's/^[[:space:]]*//')
          
          if [[ "${ext_loader^^}" == *"BOOTMGFW.EFI"* ]]; then
             ext_opts=""
          fi

          # Transform ANY backslash to forward slash for user editing, and squeeze multiple slashes to one
          efi_loader="${ext_loader//\\//}"
          while [[ "$efi_loader" == *//* ]]; do efi_loader="${efi_loader//\/\//\/}"; done
          [[ "$efi_loader" != /* ]] && efi_loader="/$efi_loader"
          
          efi_opts="$ext_opts"
          efi_label="$ext_label"
          
          ext_part=$(printf "%s\n" "$raw_entry" | grep -oE 'HD\([0-9]+,' | tr -d 'HD(,')
          [[ -n "$ext_part" ]] && efi_part="$ext_part"
      fi
  fi

  tput clear 2>/dev/null || clear
  _print_divider
  if [[ "$mode" == "edit" ]]; then
     echo "📝 EDIT/MOVE BOOT ENTRY (Boot$old_id)"
     echo "Note: EFI entries cannot be edited directly. We will create a new one and delete the old."
  elif [[ "$mode" == "clone" ]]; then
     echo "👯 CLONE BOOT ENTRY (Boot$old_id)"
     efi_label="Backup-of-${efi_label}"
  else
     echo "➕ CREATE NEW BOOT ENTRY"
  fi
  _print_divider

  # Use read -r to prevent bash from stripping backslashes during user input!
  read -r -e -i "$efi_disk" -p "Disk (Clear & Enter to abort): " efi_disk < /dev/tty
  [[ -z "$efi_disk" ]] && return
  read -r -e -i "$efi_part" -p "Partition Number: " efi_part < /dev/tty
  read -r -e -i "$efi_label" -p "Label: " efi_label < /dev/tty
  read -r -e -i "$efi_loader" -p "Loader Path (use /): " efi_loader < /dev/tty
  read -r -e -i "$efi_opts" -p "Boot Options: " efi_opts < /dev/tty
  read -r -e -i "auto" -p "Target Boot ID (e.g. 0005) or 'auto': " efi_id < /dev/tty

  # Transform forward slash back to EXACTLY ONE backslash for efibootmgr
  efi_loader="${efi_loader//\//\\}"
  while [[ "$efi_loader" == *\\\\* ]]; do efi_loader="${efi_loader//\\\\/\\}"; done
  [[ "$efi_loader" != \\* ]] && efi_loader="\\$efi_loader"

  echo
  _print_divider
  echo "SUMMARY:"
  printf "Disk: %s, Part: %s\n" "$efi_disk" "$efi_part"
  printf "Label: %s\n" "$efi_label"
  printf "Loader: %s\n" "$efi_loader"
  printf "Options: %s\n" "$efi_opts"
  printf "Target ID: %s\n" "$efi_id"
  if [[ "$mode" == "edit" ]]; then
    echo "Action: CREATE new, then DELETE Boot$old_id"
  fi
  _print_divider

  local confirm
  read -rp "Proceed? (y/N): " confirm < /dev/tty
  if [[ "${confirm,,}" == "y" || "${confirm,,}" == "yes" ]]; then
     if [[ "$efi_id" != "auto" ]]; then
        ${PRIV_ESC} efibootmgr -b "$efi_id" -B >/dev/null 2>&1
     fi

     local cmd=("efibootmgr" "-c" "-d" "$efi_disk" "-p" "$efi_part" "-L" "$efi_label" "-l" "$efi_loader")
     
     if [[ -n "$efi_opts" ]]; then
         local final_opts="$efi_opts"
         final_opts="${final_opts#"${final_opts%%[![:space:]]*}"}" # strip leading spaces
         final_opts=" $final_opts" # enforce exact single leading space
         cmd+=("-u" "$final_opts")
     fi
     
     [[ "$efi_id" != "auto" ]] && cmd+=("-I" "$efi_id")

     if ${PRIV_ESC} "${cmd[@]}" >/dev/null; then
        _pwrfzf_success "Entry created successfully."
        if [[ "$mode" == "edit" && -n "$old_id" && "$old_id" != "$efi_id" ]]; then
           ${PRIV_ESC} efibootmgr -b "$old_id" -B >/dev/null 2>&1
           _pwrfzf_success "Old entry Boot$old_id deleted."
        fi
     else
        _pwrfzf_error "Failed to create entry."
     fi
  else
     echo "Cancelled."
  fi
  read -n1 -rsp "Press any key..." < /dev/tty
}

# ------------------------------------------------------------------------------
# BTRFS SNAPSHOT MENU
# ------------------------------------------------------------------------------
function _btrfs_snapshot_menu() {
  # Pre-auth sudo to avoid FZF breaking when asking for password in background
  if [[ -n "${PRIV_ESC:-}" ]]; then
    ${PRIV_ESC} true < /dev/tty || return
  fi

  if ! command -v snapper >/dev/null 2>&1; then
    _pwrfzf_error "snapper is not installed or not in PATH."
    read -n1 -s < /dev/tty
    return
  fi

  local config_target="root"
  if ${PRIV_ESC} snapper -c home list >/dev/null 2>&1; then
    local target_choice
    tput clear 2>/dev/null || clear
    _print_divider > /dev/tty
    echo -e "Available Btrfs configs:\n1) root (System)\n2) home (User Data)" > /dev/tty
    _print_divider > /dev/tty
    read -n1 -rp "Select config (1/2): " target_choice < /dev/tty
    echo > /dev/tty
    if [[ "$target_choice" == "2" ]]; then
      config_target="home"
    fi
  fi

  if ! ${PRIV_ESC} snapper -c "$config_target" list >/dev/null 2>&1; then
    _pwrfzf_error "Snapper '$config_target' config not found or permission denied."
    read -n1 -s < /dev/tty
    return
  fi

  while true; do
    local snapshots
    # Filter header. Snapper list outputs header lines, we ignore them via tail.
    snapshots=$(${PRIV_ESC} snapper -c "$config_target" list 2>/dev/null | tail -n +3)
    
    if [[ -z "$snapshots" ]]; then
      _pwrfzf_warning "No snapshots found for $config_target."
      read -n1 -s < /dev/tty
      break
    fi

    local selected
    selected=$(echo "$snapshots" | fzf \
      --tac \
      --header="Btrfs Snapshots ($config_target) | ENTER: Rollback | ESC: Exit" \
      --preview="bash -c '\"${BASH_SOURCE[0]}\" _snapper_preview \"$config_target\" \"{1}\"'" \
      --preview-window="right:60%:wrap" \
      --border='double' --border-label="┨ Btrfs Rollback ┠" --color="${pwrfzf_colortheme}")

    [[ -z "$selected" ]] && break

    # Extract ID (first space-separated column, ignoring any layout pipes)
    local snap_id
    snap_id=$(echo "$selected" | awk '{print $1}' | tr -d '│ ')
    
    if [[ -n "$snap_id" ]]; then
      tput clear 2>/dev/null || clear
      _print_divider > /dev/tty
      echo "⚠️  WARNING: BTRFS ROLLBACK INITIATED" > /dev/tty
      echo "Target Config: $config_target" > /dev/tty
      echo "Target Snapshot ID: $snap_id" > /dev/tty
      echo > /dev/tty
      echo "This will rollback the '$config_target' filesystem to snapshot #$snap_id." > /dev/tty
      echo "A reboot may be required afterwards." > /dev/tty
      _print_divider > /dev/tty
      
      local confirm
      read -rp "Type 'ROLLBACK' to confirm: " confirm < /dev/tty
      if [[ "$confirm" == "ROLLBACK" ]]; then
        ${PRIV_ESC} snapper -c "$config_target" rollback "$snap_id" < /dev/tty
        _pwrfzf_success "Rollback configured successfully." > /dev/tty
      else
        _pwrfzf_warning "Rollback cancelled." > /dev/tty
      fi
      read -n1 -rsp "Press any key to return..." < /dev/tty
    fi
  done
}

function _snapper_preview() {
  local config_target="$1"
  local raw_input="$2"
  [[ -z "$raw_input" || -z "$config_target" ]] && return
  
  # Extract snapshot ID (First word of the string)
  local snap_id
  snap_id=$(echo "$raw_input" | awk '{print $1}' | tr -d '│ ')

  echo "=== SNAPSHOT INFO (#$snap_id in $config_target) ==="
  # Because snapper doesn't have an "info" command, we grep the exact line from 'list'
  ${PRIV_ESC} snapper -c "$config_target" list 2>/dev/null | awk -F '|' -v id="$snap_id" '{ gsub(/ /, "", $1); if ($1 == id) print $0 }'
  
  echo
  echo "=== CHANGES SINCE THIS SNAPSHOT ==="
  echo "Generating diff (this may take a few seconds)..."
  echo "Legend: + (Added) | - (Removed) | c (Modified)"
  echo "------------------------------------------------"
  # Limit to 200 lines to prevent lag
  ${PRIV_ESC} snapper -c "$config_target" status "$snap_id"..0 2>/dev/null | head -n 200
  echo "... (output truncated)"
}

# ------------------------------------------------------------------------------
# NEWS & GLSA VIEWERS
# ------------------------------------------------------------------------------
function _news_viewer() {
  if ! command -v eselect >/dev/null 2>&1; then
    _pwrfzf_error "eselect not found."
    read -n1 -s < /dev/tty
    return
  fi

  while true; do
    local news_list
    news_list=$(eselect news list 2>/dev/null)
    local parsed_news
    parsed_news=$(echo "$news_list" | grep -E '^[[:space:]]*\[[0-9]+\]')
    
    if [[ -z "$parsed_news" ]]; then
      echo "✅ No news found."
      read -n1 -rsp "Press any key to return..." </dev/tty
      break
    fi
    
    local selected
    selected=$(echo "$parsed_news" | fzf \
      --header "Gentoo News | ENTER: Read | F2: Mark Read | F3: Mark Unread | F4: Purge Read | ESC: Exit" \
      --preview "eselect news read \$(echo {} | awk '{print \$1}' | tr -d '[]*N') 2>/dev/null" \
      --preview-window="right:60%:wrap:follow" \
      --bind "f2:execute(bash -c '${PRIV_ESC} eselect news read \$(echo {1} | tr -d \"[]*N\") >/dev/null')+reload(eselect news list 2>/dev/null | grep -E '^[[:space:]]*\[[0-9]+\]')" \
      --bind "f3:execute(bash -c '${PRIV_ESC} eselect news unread \$(echo {1} | tr -d \"[]*N\") >/dev/null')+reload(eselect news list 2>/dev/null | grep -E '^[[:space:]]*\[[0-9]+\]')" \
      --bind "f4:execute(bash -c '${PRIV_ESC} eselect news purge >/dev/null')+reload(eselect news list 2>/dev/null | grep -E '^[[:space:]]*\[[0-9]+\]')" \
      --border 'double' --border-label="┨${PROG} - Gentoo News┠" --color="${pwrfzf_colortheme}")
    
    [[ -z "$selected" ]] && break
    
    # PERFORMANCE BOOST: Use Bash parameter expansion instead of awk/tr pipeline
    local news_item
    read -r news_item _ <<< "$selected"
    news_item="${news_item//\[/}"
    news_item="${news_item//\]/}"
    news_item="${news_item//\*/}"
    news_item="${news_item//N/}"

    if [[ -n "$news_item" ]]; then
      # Read WITH privilege escalation so it gets marked as read!
      ${PRIV_ESC} eselect news read "$news_item" | _fzf_viewer "News Item: $news_item"
    fi
  done
}

function _get_glsa_list() {
  local flag_file="${PWRFZF_CACHE_DIR}/.show_all_glsa"
  local cmd="${PRIV_ESC} glsa-check -n -l"
  
  if [[ -f "$flag_file" ]]; then
    cmd="$cmd all"
  else
    cmd="$cmd affected"
  fi

  # Apply dynamic sorting based on user config (newest top vs oldest top)
  if [[ "${PWRFZF_GLSA_REVERSE}" == "true" ]]; then
    $cmd 2>/dev/null | grep -E '^[0-9]{6}-[0-9]{2}' | sort -r
  else
    $cmd 2>/dev/null | grep -E '^[0-9]{6}-[0-9]{2}'
  fi
}

function _toggle_glsa() {
  local flag_file="${PWRFZF_CACHE_DIR}/.show_all_glsa"
  if [[ -f "$flag_file" ]]; then
    rm -f "$flag_file"
  else
    touch "$flag_file"
  fi
  _get_glsa_list
}

function _glsa_viewer() {
  if ! command -v glsa-check >/dev/null 2>&1; then
    _pwrfzf_error "glsa-check not found. Please emerge app-portage/gentoolkit."
    read -n1 -s < /dev/tty
    return
  fi

  # Pre-authenticate sudo so password prompts don't corrupt FZF
  if [[ -n "${PRIV_ESC:-}" ]]; then
    $PRIV_ESC true < /dev/tty
  fi

  # Always start with only 'affected' GLSAs
  rm -f "${PWRFZF_CACHE_DIR}/.show_all_glsa"

  # Force absolute path to prevent $PATH confusion where FZF runs an old script version
  local script_cmd
  if command -v realpath >/dev/null 2>&1; then
    script_cmd="$(realpath "${BASH_SOURCE[0]}")"
  else
    script_cmd="${BASH_SOURCE[0]}"
  fi

  while true; do
    local selected
    selected=$("$script_cmd" _get_glsa_list | fzf \
      --header "GLSA | ENTER: View | F2: Fix | F3: Inject (Ignore) | CTRL-A: Toggle All/Affected | ESC: Exit" \
      --preview "${PRIV_ESC} glsa-check -n -d {1} 2>/dev/null" \
      --preview-window="right:60%:wrap:follow" \
      --bind "ctrl-a:reload(\"$script_cmd\" _toggle_glsa)" \
      --bind "f2:execute(bash -c '${PRIV_ESC} glsa-check -f {1}; echo; read -n1 -rsp \"Press any key to return...\" </dev/tty')+reload(\"$script_cmd\" _get_glsa_list)" \
      --bind "f3:execute(bash -c '${PRIV_ESC} glsa-check -i {1} >/dev/null; echo \"✅ GLSA {1} injected (ignored).\"; sleep 1')+reload(\"$script_cmd\" _get_glsa_list)" \
      --border 'double' --border-label="┨${PROG} - Security Advisories┠" --color="${pwrfzf_colortheme}")
    
    [[ -z "$selected" ]] && break
    
    # PERFORMANCE BOOST: Built-in string split instead of awk subshell
    local glsa_id
    read -r glsa_id _ <<< "$selected"
    [[ -n "$glsa_id" ]] && ${PRIV_ESC} glsa-check -n -d "$glsa_id" | _fzf_viewer "GLSA: $glsa_id"
  done
}

# ------------------------------------------------------------------------------
# EMERGE HISTORY & ELOG VIEWER
# ------------------------------------------------------------------------------
function _elogfzf_viewer() {
  if ! ${PRIV_ESC} test -d "$ELOG_DIR"; then
    echo "eLog directory not found at $ELOG_DIR"
    read -n1 -s < /dev/tty
    return
  fi

  local bat_cmd="cat"
  command -v bat >/dev/null 2>&1 && bat_cmd="bat --style=plain --color=always"

  while true; do
    local log_files=""
    
    log_files=$(${PRIV_ESC} find "$ELOG_DIR" -type f -printf "%T@ %p\n" 2>/dev/null | sort -nr | cut -d' ' -f2-)

    [[ -z "$log_files" ]] && { echo "No eLog files found."; sleep 1; break; }

    # Setup the reload command
    local reload_cmd="${PRIV_ESC} find \"$ELOG_DIR\" -type f -printf \"%T@ %p\n\" 2>/dev/null | sort -nr | cut -d\" \" -f2-"

    local selected
    # FZF natively auto-escapes {} when not wrapped in quotes. This fixes the file paths!
    selected=$(echo "$log_files" | fzf \
      --preview "${PRIV_ESC} $bat_cmd {} 2>/dev/null || ${PRIV_ESC} cat {}" \
      --preview-window="right:60%:wrap:follow" \
      --bind "f2:execute(${PRIV_ESC} rm -i {})+reload($reload_cmd)" \
      --bind "f3:execute(bash -c 'read -p \"Delete ALL eLogs? (yes/NO): \" confirm; [[ \$confirm == yes ]] && ${PRIV_ESC} find \"$ELOG_DIR\" -type f -delete && echo \"All logs deleted.\"; read -n1 -rsp \"Press any key...\" < /dev/tty')+reload($reload_cmd)" \
      --bind "pgup:preview-page-up,pgdn:preview-page-down" \
      --header "ENTER: open | F2: delete log | F3: delete ALL logs | ESC: return" \
      --border 'double' --border-label="┨${PROG} - eLog Viewer (elogfzf)┠" --color="${pwrfzf_colortheme}")
    
    [[ -z "$selected" ]] && break
    
    # Launch editor natively in the main loop to avoid subshell issues
    _launch_editor "$selected"
  done
}

function _recent_build_logs_viewer() {
  local log_dir="${_P_LOG:-/var/log/portage}"
  if ! ${PRIV_ESC} test -d "$log_dir"; then
    echo "Log directory not found at $log_dir"
    read -n1 -s < /dev/tty
    return
  fi

  local bat_cmd="cat"
  command -v bat >/dev/null 2>&1 && bat_cmd="bat --style=plain --color=always"

  # Portage either puts logs in /var/log/portage or /var/log/portage/build (if split-log is enabled)
  local search_paths=("$log_dir")
  if ${PRIV_ESC} test -d "$log_dir/build"; then
    search_paths+=("$log_dir/build")
  fi

  while true; do
    local log_files=""
    
    # 1. Find all .log files in the dirs
    # 2. Sort by time (newest first)
    # 3. Take the last 200 to keep it fast
    # 4. Grep for " * ERROR: " OR "!!! " which are the standard Gentoo failure markers (including fetch errors)
    log_files=$(${PRIV_ESC} find "${search_paths[@]}" -type f -name "*.log" -printf "%T@ %p\n" 2>/dev/null | sort -nr | head -n 200 | cut -d' ' -f2- | ${PRIV_ESC} xargs -d '\n' -r grep -l -E -m 1 "( \* ERROR:|!!! )" 2>/dev/null)

    if [[ -z "$log_files" ]]; then
      echo "✅ No failed build logs found in the recent history."
      read -n1 -rsp "Press any key to return..." < /dev/tty
      break
    fi

    local reload_cmd="${PRIV_ESC} find \"${search_paths[@]}\" -type f -name \"*.log\" -printf \"%T@ %p\n\" 2>/dev/null | sort -nr | head -n 200 | cut -d\" \" -f2- | ${PRIV_ESC} xargs -d '\n' -r grep -l -E -m 1 \"( \\* ERROR:|!!! )\" 2>/dev/null"

    local selected
    selected=$(echo "$log_files" | fzf \
      --preview "${PRIV_ESC} $bat_cmd {} 2>/dev/null || ${PRIV_ESC} cat {}" \
      --preview-window="right:60%:wrap:follow" \
      --bind "f2:execute(${PRIV_ESC} rm -i {})+reload($reload_cmd)" \
      --bind "pgup:preview-page-up,pgdn:preview-page-down" \
      --header "ENTER: open | F2: delete log | ESC: return" \
      --border 'double' --border-label="┨${PROG} - Failed Build Logs┠" --color="${pwrfzf_colortheme}")
    
    [[ -z "$selected" ]] && break
    
    _launch_editor "$selected"
  done
}

function _show_emerge_history() {
  local history_mode="${PWRFZF_HISTORY_CMD:-elogv}"

  if [[ "$history_mode" == "auto" ]]; then
    if [[ -d "$ELOG_DIR" ]] && [[ -n "$(${PRIV_ESC} ls -A "$ELOG_DIR" 2>/dev/null)" ]]; then
      history_mode="elogv"
    elif command -v genlop >/dev/null 2>&1; then
      history_mode="genlop"
    elif command -v qlop >/dev/null 2>&1; then
      history_mode="qlop"
    elif [[ -f "$EMERGE_LOG" ]]; then
      history_mode="log"
    else
      history_mode="elogv"
    fi
  fi

  case "$history_mode" in
    elogfzf)
      _elogfzf_viewer
      ;;
    elogv)
      if command -v elogv >/dev/null 2>&1; then
        if [[ $EUID -eq 0 ]]; then
          elogv < /dev/tty
        else
          ${PRIV_ESC} elogv < /dev/tty
        fi
      else
        echo "elogv is not installed. Please emerge app-portage/elogv"
        read -n1 -s < /dev/tty
      fi
      ;;
    genlop)
      if [[ $EUID -eq 0 ]]; then
        genlop -l | fzf --tac --no-sort --ansi --header "Emerge History (genlop)" \
          --border 'double' --border-label="┨${PROG} - History┠" --color="${pwrfzf_colortheme}"
      else
        ${PRIV_ESC} genlop -l | fzf --tac --no-sort --ansi --header "Emerge History (genlop)" \
          --border 'double' --border-label="┨${PROG} - History┠" --color="${pwrfzf_colortheme}"
      fi
      ;;
    qlop)
      if [[ $EUID -eq 0 ]]; then
        qlop -l | fzf --tac --no-sort --ansi --header "Emerge History (qlop)" \
          --border 'double' --border-label="┨${PROG} - History┠" --color="${pwrfzf_colortheme}"
      else
        ${PRIV_ESC} qlop -l | fzf --tac --no-sort --ansi --header "Emerge History (qlop)" \
          --border 'double' --border-label="┨${PROG} - History┠" --color="${pwrfzf_colortheme}"
      fi
      ;;
    log)
      if ${PRIV_ESC} test -f "$EMERGE_LOG"; then
        ${PRIV_ESC} grep -E '(completed|unmerged)' "$EMERGE_LOG" | fzf --tac --no-sort \
          --header "Emerge History (emerge.log)" --border 'double' \
          --border-label="┨${PROG} - History┠" --color="${pwrfzf_colortheme}"
      else
        echo "emerge.log not found."
        read -n1 -s < /dev/tty
      fi
      ;;
    *)
      echo "Unknown history mode: $history_mode"
      read -n1 -s < /dev/tty
      ;;
  esac
}

# ------------------------------------------------------------------------------
# PORTAGE CONFIGURATION MANAGERS (DASHBOARD)
# ------------------------------------------------------------------------------
# Universal Preview Command for all File/Dir FZF pickers
readonly PREVIEW_CMD="if [[ -d {} ]]; then echo '=== DIRECTORY: {} ==='; echo '══════════════════════════════════════'; ls -lh --color=always {} 2>/dev/null || ls -lh {}; else echo '=== FILE: {} ==='; echo '══════════════════════════════════════'; cat {} 2>/dev/null | head -100; fi"

function _portage_config_manager() {
  while true; do
    local mode
    mode=$(echo -e "─── PORTAGE CONFIGURATION ───\n1. 🧙 Guided Configuration Wizards\n2. 📁 Browse Config Directory\n3. ⚙️  Edit pwrfzf.conf\n─── SYSTEM MANAGEMENT ───\n4. 🔄 Run System Config Updater ($PWRFZF_CONFIG_UPDATER)\n─── LOGS & SECURITY ───\n5. 📜 View eLogs / Emerge History\n6. 📰 View Gentoo News (eselect)\n7. 🛡️ Check Security Advisories (GLSA)\n8. Back" | fzf \
      --header "Portage Management" \
      --border-label="┨ Portage Management ┠" \
      --border 'double' \
      --color="${pwrfzf_colortheme}")

    case "$mode" in
      *Guided*) _guided_wizards ;;
      *Browse*) _file_browser ;;
      *History*) _show_emerge_history ;;
      *News*) _news_viewer ;;
      *GLSA*) _glsa_viewer ;;
      *Run*System*Config*Updater*) _run_config_updater ;;
      *Edit*pwrfzf.conf*) 
         _launch_editor "$PWRFZF_CONFIG_FILE"
         # Reload configuration instantly after the editor closes
         _load_config
         _validate_config
         _set_colors
         ;;
      *Back*|"") break ;;
      *) continue ;; # Handle visual separator selection seamlessly
    esac
  done
}

function _file_browser() {
  while true; do
    local selected_file
    selected_file=$(find "${PORTAGE_ETC}" -mindepth 1 2>/dev/null | fzf \
      --header "Browse Configuration (Enter=Action, ESC=Back)" \
      --preview-window 'right,60%,border-left' \
      --preview "$PREVIEW_CMD" \
      --border 'double' \
      --border-label="┨${PROG} - Explorer┠" \
      --color="${pwrfzf_colortheme}")

    [[ -z "$selected_file" ]] && break
    _file_action_menu "$selected_file"
  done
}

function _file_action_menu() {
  local file="$1"
  
  if [[ -d "$file" ]]; then
    echo "This is a directory. Please select a file to edit or view."
    sleep 1
    return
  fi

  while true; do
    local action
    action=$(echo -e "Edit\nView\nDelete\nBack" | fzf \
      --header "File Actions: $(basename "$file")" \
      --border 'double' \
      --border-label="┨${PROG} - Action┠" \
      --color="${pwrfzf_colortheme}")

    case "$action" in
      "Edit") _launch_editor "$file" ; break ;;
      "View") cat "$file" | _fzf_viewer "Viewing: $(basename "$file")" ;;
      "Delete")
         _print_divider
         echo "Delete $file?"
         read -rp "Type 'yes' to confirm: " ans
         if [[ "$ans" == "yes" ]]; then
            ${PRIV_ESC} rm -f "$file"
            _pwrfzf_success "Deleted $file"
            _clear_preview_cache
            sleep 1
         fi
         break
         ;;
      "Back"|"") break ;;
    esac
  done
}

function _guided_wizards() {
  while true; do
    local config_type
    config_type=$(echo -e "make.conf\naccept_keywords\nuse\nmask\nunmask\nenv\nsets" | fzf \
      --bind 'enter:accept' \
      --bind 'esc:abort' \
      --header 'Select Portage config type (Enter=select, ESC=back)' \
      --preview-window 'right,60%,border-left' \
      --border-label-pos=3 \
      --border 'double' \
      --border-label="┨${PROG} - Wizards┠" \
      --ansi \
      --color="${pwrfzf_colortheme}" \
      --preview="${BASH_SOURCE[0]} _config_preview {}")
    
    [[ -z "$config_type" ]] && break
    _manage_config_type "$config_type"
  done
}

function _config_preview() {
  local config_type="$1"
  case "$config_type" in
    "make.conf") _make_conf_preview ;;
    "sets") _sets_preview ;;
    *) _portage_config_preview "$config_type" ;;
  esac
}

function _make_conf_preview() {
  local make_conf="${PORTAGE_ETC}/make.conf"
  local make_conf_dir="${PORTAGE_ETC}/make.conf.d"
  
  echo "make.conf Configuration"
  _print_divider
  
  if [[ -f "$make_conf" ]]; then
    echo "=== make.conf ==="
    _print_divider
    cat "$make_conf" 2>/dev/null
    echo
  else
    echo "No make.conf found at: $make_conf"
    echo
  fi
  
  if [[ -d "$make_conf_dir" ]]; then
    echo "=== make.conf.d Directory ==="
    echo "Files found:"
    find "$make_conf_dir" -type f 2>/dev/null | head -10 | while read -r file; do
      echo "• $file"
    done
    echo
    
    local first_file
    first_file=$(find "$make_conf_dir" -type f 2>/dev/null | head -1)
    if [[ -n "$first_file" ]]; then
      echo "First file content:"
      echo "File: $first_file"
      _print_divider
      cat "$first_file" 2>/dev/null
    fi
  else
    echo "No make.conf.d directory found at: $make_conf_dir"
  fi
}

function _portage_config_preview() {
  local config_type="$1"
  local config_base="${PORTAGE_ETC}/package.$config_type"
  
  if [[ ! -e "$config_base" ]]; then
    echo "No configuration found"
    echo "Create new file or directory at:"
    echo "$config_base"
    return
  fi
  
  if [[ -f "$config_base" ]]; then
    echo "Single file configuration:"
    echo "File: $config_base"
    _print_divider
    cat "$config_base" 2>/dev/null
  elif [[ -d "$config_base" ]]; then
    echo "Directory configuration:"
    echo "Path: $config_base"
    echo "Files found:"
    find "$config_base" -type f 2>/dev/null | head -10 | while read -r file; do
      echo "• $file"
    done
    echo
    
    local first_file
    first_file=$(find "$config_base" -type f 2>/dev/null | head -1)
    if [[ -n "$first_file" ]]; then
      echo "First file content:"
      echo "File: $first_file"
      _print_divider
      cat "$first_file" 2>/dev/null
    fi
  fi
  
  if [[ "$config_type" == "env" ]]; then
    local env_dir="${PORTAGE_ETC}/env"
    if [[ -d "$env_dir" ]]; then
      echo
      _print_divider
      echo "Additional environment files in: $env_dir"
      echo "Files found:"
      find "$env_dir" -type f 2>/dev/null | head -10 | while read -r file; do
        echo "• $file"
      done
      echo
      local first_env_file
      first_env_file=$(find "$env_dir" -type f 2>/dev/null | head -1)
      if [[ -n "$first_env_file" ]]; then
        echo "First env file content:"
        echo "File: $first_env_file"
        _print_divider
        cat "$first_env_file" 2>/dev/null
      fi
    fi
  fi
}

function _sets_preview() {
  local sets_dir="${PORTAGE_ETC}/sets"
  local sets_conf="${PORTAGE_ETC}/sets.conf"
  
  echo "Package Sets Configuration"
  _print_divider
  
  if [[ -f "$sets_conf" ]]; then
    echo "sets.conf:"
    _print_divider
    cat "$sets_conf" 2>/dev/null
    echo
  fi
  
  if [[ -d "$sets_dir" ]]; then
    echo "Package set files:"
    find "$sets_dir" -type f 2>/dev/null | head -10 | while read -r file; do
      echo "• $file"
    done
    echo
    
    local first_file
    first_file=$(find "$sets_dir" -type f 2>/dev/null | head -1)
    if [[ -n "$first_file" ]]; then
      echo "First set file content:"
      echo "File: $first_file"
      _print_divider
      cat "$first_file" 2>/dev/null
    fi
  else
    echo "No package sets directory found at: $sets_dir"
  fi
}

function _manage_config_type() {
  local config_type="$1"
  case "$config_type" in
    "make.conf") _manage_make_conf ;;
    "sets") _manage_sets ;;
    *) _manage_portage_config "$config_type" ;;
  esac
}

function _manage_make_conf() {
  local make_conf="${PORTAGE_ETC}/make.conf"
  
  while true; do
    local action
    action=$(echo -e "Edit make.conf\nBrowse make.conf.d files\nAdd make.conf.d file\nBack" | fzf \
      --bind 'esc:abort' \
      --header "Manage make.conf Configuration" \
      --preview-window 'right,60%,border-left' \
      --border-label-pos=3 \
      --border 'double' \
      --border-label="┨${PROG} - make.conf┠" \
      --ansi \
      --color="${pwrfzf_colortheme}" \
      --preview="${BASH_SOURCE[0]} _make_conf_action_preview {}")
    
    case "$action" in
      "Edit make.conf") _launch_editor "$make_conf" ;;
      "Browse make.conf.d files") _browse_make_conf_d ;;
      "Add make.conf.d file") _add_make_conf_d_file ;;
      "Back"|"") break ;;
    esac
  done
}

function _make_conf_action_preview() {
  local action="$1"
  case "$action" in
    "Edit make.conf")
      echo "Edit main make.conf file"
      echo "Global Portage settings like USE flags, CFLAGS, etc."
      echo
      echo "File: ${PORTAGE_ETC}/make.conf"
      echo
      echo "Current content preview:"
      head -10 "${PORTAGE_ETC}/make.conf" 2>/dev/null || echo "No make.conf found"
      ;;
    "Browse make.conf.d files")
      echo "Browse make.conf.d directory"
      echo "Split configuration across multiple files"
      echo
      echo "Available files:"
      find "${PORTAGE_ETC}/make.conf.d" -type f 2>/dev/null | head -5 | while read -r file; do
        echo "• $(basename "$file")"
      done || echo "No make.conf.d directory"
      ;;
    "Add make.conf.d file")
      echo "Add new make.conf.d file"
      echo "Create a new configuration file in make.conf.d"
      echo
      echo "Example file content:"
      echo "USE=\"X wayland pulseaudio\""
      echo "CFLAGS=\"-O2 -pipe\""
      echo "CXXFLAGS=\"\${CFLAGS}\""
      ;;
  esac
}

function _browse_make_conf_d() {
  local make_conf_dir="${PORTAGE_ETC}/make.conf.d"
  
  if [[ ! -d "$make_conf_dir" ]]; then
    echo "No make.conf.d directory found at: $make_conf_dir"
    echo "Create it? (y/N)"
    read -r answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      ${PRIV_ESC} mkdir -p "$make_conf_dir"
      echo "Created: $make_conf_dir"
    else
      return
    fi
  fi
  
  while true; do
    local selected_file
    selected_file=$(find "$make_conf_dir" -mindepth 1 2>/dev/null | fzf \
      --bind 'enter:accept' \
      --bind 'esc:abort' \
      --header "Select make.conf.d file (Enter=edit, ESC=back)" \
      --preview-window 'right,60%,border-left' \
      --border-label-pos=3 \
      --border 'double' \
      --border-label="┨${PROG} - make.conf.d┠" \
      --ansi \
      --color="${pwrfzf_colortheme}" \
      --preview="$PREVIEW_CMD")
    
    [[ -z "$selected_file" ]] && break
    if [[ -d "$selected_file" ]]; then
      echo "Cannot edit a directory directly. Please select a file."
      sleep 1
      continue
    fi
    _launch_editor "$selected_file"
  done
}

function _add_make_conf_d_file() {
  local make_conf_dir="${PORTAGE_ETC}/make.conf.d"
  local filename new_file
  
  _print_divider
  echo "Add make.conf.d file"
  echo "Enter filename:"
  read -rp "Filename: " filename
  [[ -z "$filename" ]] && return
  
  if [[ "$filename" != *.conf ]]; then
    filename="${filename}.conf"
  fi
  new_file="$make_conf_dir/$filename"
  
  echo
  _print_divider
  echo "CONFIRM CREATION:"
  echo "File: $new_file"
  echo
  read -rp "Create this file? (y/N) " answer
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    ${PRIV_ESC} mkdir -p "$make_conf_dir"
    ${PRIV_ESC} touch "$new_file"
    _pwrfzf_success "Created make.conf.d file: $filename"
    
    echo
    read -rp "Edit file now? (y/N) " edit_answer
    if [[ "$edit_answer" =~ ^[Yy]$ ]]; then
      _launch_editor "$new_file"
    fi
  fi
}

function _manage_portage_config() {
  local config_type="$1"
  
  while true; do
    local action
    action=$(echo -e "Preview files\nEdit files\nDelete files\nAdd new entry\nBack" | fzf \
      --bind 'esc:abort' \
      --header "Manage package.$config_type" \
      --preview-window 'right,60%,border-left' \
      --border-label-pos=3 \
      --border 'double' \
      --border-label="┨${PROG} - ${PORTAGE_CONFIG_TYPES[$config_type]}┠" \
      --ansi \
      --color="${pwrfzf_colortheme}" \
      --preview="${BASH_SOURCE[0]} _action_preview {} $config_type")
    
    case "$action" in
      "Preview files") _view_config_type "$config_type" | _fzf_viewer "Preview: package.$config_type" ;;
      "Edit files") _edit_config_files "$config_type" ;;
      "Delete files") _delete_config_files_interactive "$config_type" ;;
      "Add new entry") _add_config_entry "$config_type" ;;
      "Back"|"") break ;;
    esac
  done
}

function _delete_config_files_interactive() {
  local config_type="$1"
  local config_base="${PORTAGE_ETC}/package.$config_type"
  
  if [[ ! -e "$config_base" ]]; then
    echo "No configuration found for package.$config_type"
    return
  fi
  
  while true; do
    local all_files=()
    if [[ "$config_type" == "env" && -d "${PORTAGE_ETC}/env" ]]; then
      mapfile -d '' env_files < <(find "${PORTAGE_ETC}/env" -mindepth 1 -print0 2>/dev/null)
      all_files+=("${env_files[@]}")
    fi
    
    if [[ -d "$config_base" ]]; then
      mapfile -d '' base_files < <(find "$config_base" -mindepth 1 -print0 2>/dev/null)
      all_files+=("${base_files[@]}")
    elif [[ -f "$config_base" ]]; then
      all_files+=("$config_base")
    fi
    
    if [[ ${#all_files[@]} -eq 0 ]]; then
      echo "No more files to delete."
      break
    fi
    
    _print_divider
    echo "🗑️  DELETE CONFIGURATION FILES"
    echo "Config type: package.$config_type"
    echo
    
    local selected_file
    selected_file=$(printf '%s\n' "${all_files[@]}" | fzf \
      --bind 'enter:accept' \
      --bind 'esc:abort' \
      --header "Select file to delete (Enter=delete, ESC=back)" \
      --preview-window 'right,60%,border-left' \
      --border-label-pos=3 \
      --border 'double' \
      --border-label="┨${PROG} - Delete Files┠" \
      --ansi \
      --color="${pwrfzf_colortheme}" \
      --preview="$PREVIEW_CMD")

    [[ -z "$selected_file" ]] && break
    
    if [[ -d "$selected_file" ]]; then
      echo "To delete a directory, please use the Explorer mode or terminal."
      sleep 1
      continue
    fi
    
    _delete_config_file "$selected_file" "$config_type"
  done
}

function _manage_sets() {
  while true; do
    local action
    action=$(echo -e "View sets.conf\nEdit sets.conf\nBrowse package sets\nAdd package set\nBack" | fzf \
      --bind 'esc:abort' \
      --header "Manage Package Sets" \
      --preview-window 'right,60%,border-left' \
      --border-label-pos=3 \
      --border 'double' \
      --border-label="┨${PROG} - Package Sets┠" \
      --ansi \
      --color="${pwrfzf_colortheme}" \
      --preview="${BASH_SOURCE[0]} _sets_action_preview {}")
    
    case "$action" in
      "View sets.conf") _view_sets_conf | _fzf_viewer "Preview: sets.conf" ;;
      "Edit sets.conf") _edit_sets_conf ;;
      "Browse package sets") _browse_package_sets ;;
      "Add package set") _add_package_set ;;
      "Back"|"") break ;;
    esac
  done
}

function _sets_action_preview() {
  local action="$1"
  case "$action" in
    "View sets.conf") echo "Preview ${PORTAGE_ETC}/sets.conf" ;;
    "Edit sets.conf") echo "Edit ${PORTAGE_ETC}/sets.conf" ;;
    "Browse package sets") echo "Browse and edit custom package sets in ${PORTAGE_ETC}/sets/" ;;
    "Add package set") echo "Create a new package set file" ;;
  esac
}

function _action_preview() {
  local action="$1"
  local config_type="$2"
  
  case "$action" in
    "Preview files")
      echo "Preview all configuration files"
      echo "Shows complete content of all files"
      echo
      echo "Preview of first file:"
      local config_base="${PORTAGE_ETC}/package.$config_type"
      local first_file
      first_file=$(find "$config_base" -type f 2>/dev/null | head -1)
      if [[ -n "$first_file" ]]; then
        echo "File: $first_file"
        head -5 "$first_file" 2>/dev/null
      fi
      ;;
    "Edit files")
      echo "Edit configuration files"
      echo "Select and edit individual files"
      echo
      echo "Available files:"
      find "${PORTAGE_ETC}/package.$config_type" -type f 2>/dev/null | head -5
      ;;
    "Delete files")
      echo "Delete configuration files"
      echo "Permanently remove configuration files"
      echo
      echo "Available files for deletion:"
      find "${PORTAGE_ETC}/package.$config_type" -type f 2>/dev/null | head -5
      echo
      echo "⚠️  WARNING: This action cannot be undone!"
      ;;
    "Add new entry")
      echo "Add new configuration entry"
      echo "Add package with keywords, USE flags, etc."
      echo
      echo "Example:"
      case "$config_type" in
        accept_keywords) echo "dev-util/github-cli ~amd64" ;;
        use) echo "www-client/firefox -gtk +wayland pulseaudio" ;;
        mask) echo ">app-office/libreoffice-7.6.0" ;;
        unmask) echo "app-emulation/wine-proton" ;;
        env) echo "app-editors/neovim noinfo debug" ;;
      esac
      ;;
  esac
}

function _view_sets_conf() {
  local sets_conf="${PORTAGE_ETC}/sets.conf"
  
  if [[ -f "$sets_conf" ]]; then
    echo "=== sets.conf ==="
    _print_divider
    cat "$sets_conf" 2>/dev/null
  else
    echo "No sets.conf found at: $sets_conf"
  fi
}

function _view_config_type() {
  local config_type="$1"
  local config_base="${PORTAGE_ETC}/package.$config_type"
  
  if [[ ! -e "$config_base" ]]; then
    echo "No configuration found for package.$config_type"
    return
  fi
  
  if [[ -f "$config_base" ]]; then
    echo "=== Single file: $config_base ==="
    _print_divider
    cat "$config_base" 2>/dev/null
  elif [[ -d "$config_base" ]]; then
    find "$config_base" -type f 2>/dev/null | while read -r file; do
      echo
      echo "=== FILE: $file ==="
      _print_divider
      cat "$file" 2>/dev/null
      echo
    done
  fi
  
  if [[ "$config_type" == "env" && -d "${PORTAGE_ETC}/env" ]]; then
    echo
    echo "=== ENVIRONMENT FILES (${PORTAGE_ETC}/env/) ==="
    _print_divider
    find "${PORTAGE_ETC}/env" -type f 2>/dev/null | while read -r file; do
      echo
      echo "=== FILE: $file ==="
      _print_divider
      cat "$file" 2>/dev/null
      echo
    done
  fi
}

function _edit_config_files() {
  local config_type="$1"
  local config_base="${PORTAGE_ETC}/package.$config_type"
  
  if [[ ! -e "$config_base" ]]; then
    read -rp "No configuration found. Create new file? (y/N) " answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      _launch_editor "$config_base"
    fi
    return
  fi
  
  local all_files=()
  if [[ "$config_type" == "env" && -d "${PORTAGE_ETC}/env" ]]; then
    mapfile -d '' env_files < <(find "${PORTAGE_ETC}/env" -mindepth 1 -print0 2>/dev/null)
    all_files+=("${env_files[@]}")
  fi
  
  if [[ -d "$config_base" ]]; then
    mapfile -d '' base_files < <(find "$config_base" -mindepth 1 -print0 2>/dev/null)
    all_files+=("${base_files[@]}")
  elif [[ -f "$config_base" ]]; then
    all_files+=("$config_base")
  fi
  
  if [[ ${#all_files[@]} -eq 0 ]]; then
    echo "No files found for package.$config_type"
    return
  fi
  
  while true; do
    local selected_file
    selected_file=$(printf '%s\n' "${all_files[@]}" | fzf \
      --bind 'enter:accept+abort' \
      --bind 'esc:abort' \
      --header "Select file to edit (Enter=edit, ESC=back)" \
      --preview-window 'right,60%,border-left' \
      --border-label-pos=3 \
      --border 'double' \
      --border-label="┨${PROG} - File Browser┠" \
      --ansi \
      --color="${pwrfzf_colortheme}" \
      --preview="$PREVIEW_CMD")
    
    [[ -z "$selected_file" ]] && break
    
    if [[ -d "$selected_file" ]]; then
      echo "Cannot edit a directory directly. Please select a file."
      sleep 1
      continue
    fi
    
    _launch_editor "$selected_file"
  done
}

function _delete_config_file() {
  local file_path="$1"
  local config_type="$2"
  
  _print_divider
  echo "🗑️  DELETE CONFIGURATION FILE"
  echo "File: $file_path"
  echo "Type: package.$config_type"
  echo
  echo "WARNING: This will permanently delete the file!"
  echo
  read -rp "Are you absolutely sure? (type 'yes' to confirm, any other to cancel) " confirmation
  
  if [[ "$confirmation" == "yes" ]]; then
    if ${PRIV_ESC} rm -f "$file_path"; then
      echo "✅ File deleted: $file_path"
      _clear_preview_cache
      local parent_dir
      parent_dir=$(dirname "$file_path")
      if [[ -d "$parent_dir" ]] && [[ "$parent_dir" != "${PORTAGE_ETC}" ]]; then
        if ${PRIV_ESC} rmdir "$parent_dir" 2>/dev/null; then
          echo "✅ Removed empty directory: $parent_dir"
        fi
      fi
    else
      echo "❌ Failed to delete file: $file_path"
    fi
  else
    echo "⚠️ Deletion cancelled"
  fi
}

function _add_config_entry() {
  local config_type="$1"
  local package config_entry new_entry config_file
  
  _print_divider
  echo "Enter package name (atom):"
  echo "Example: app-editors/neovim or app-misc/yazi::guru"
  read -rp "Package: " package
  [[ -z "$package" ]] && return
  
  case "$config_type" in
    accept_keywords)
      echo
      _print_divider
      echo "Select keywords for $package:"
      config_entry=$(echo -e "~amd64\n~arm64\namd64\narm64\n-**" | fzf --prompt "Keywords: ")
      ;;
    use)
      echo
      _print_divider
      echo "Enter USE flags for $package:"
      echo "Format: +flag to enable, -flag to disable"
      echo "Example: +gtk -qt wayland pulseaudio"
      read -rp "USE flags: " config_entry
      if [[ ! "$config_entry" =~ ^[+-]?[a-zA-Z0-9_]+([[:space:]]+[+-]?[a-zA-Z0-9_]+)*$ ]]; then
        _pwrfzf_warning "USE flags should start with + or - followed by flag name"
      fi
      ;;
    mask|unmask)
      echo
      _print_divider
      echo "Select mask type for $package:"
      config_entry=$(echo -e "$package\n>$package\n<$package\n=$package" | fzf --prompt "Mask: ")
      ;;
    env)
      echo
      _print_divider
      echo "Select environment for $package:"
      config_entry=$(echo -e "noinfo\ndebug\nconfcache\nstrict\ntest" | fzf --prompt "Environment: ")
      ;;
    *)
      echo
      _print_divider
      echo "Enter configuration for $package:"
      read -r config_entry
      ;;
  esac
  
  [[ -z "$config_entry" ]] && return
  new_entry="$package $config_entry"
  
  echo
  _print_divider
  echo "Select target configuration file:"
  config_file=$(_select_config_file "$config_type")
  [[ -z "$config_file" ]] && return
  
  echo
  _print_divider
  echo "CONFIRM ADDITION:"
  echo "Entry: $new_entry"
  echo "File: $config_file"
  echo
  read -rp "Add this entry? (y/N) " answer
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    ${PRIV_ESC} mkdir -p "$(dirname "$config_file")"
    
    # Ensure trailing newline safely before appending
    ${PRIV_ESC} bash -c "[[ -s \"$config_file\" && \$(tail -c1 \"$config_file\" | wc -l) -eq 0 ]] && echo \"\" >> \"$config_file\""
    
    echo "$new_entry" | ${PRIV_ESC} tee -a "$config_file" >/dev/null
    _pwrfzf_success "Added to $config_file: $new_entry"
    _clear_preview_cache
  else
    _pwrfzf_warning "Addition cancelled"
  fi
}

function _select_config_file() {
  local config_type="$1"
  local config_base="${PORTAGE_ETC}/package.$config_type"
  local all_files=()
  
  if [[ "$config_type" == "env" && -d "${PORTAGE_ETC}/env" ]]; then
    mapfile -d '' env_files < <(find "${PORTAGE_ETC}/env" -mindepth 1 -print0 2>/dev/null)
    all_files+=("${env_files[@]}")
  fi
  
  if [[ -d "$config_base" ]]; then
    mapfile -d '' base_files < <(find "$config_base" -mindepth 1 -print0 2>/dev/null)
    all_files+=("${base_files[@]}")
  elif [[ -f "$config_base" ]]; then
    all_files+=("$config_base")
  fi
  
  if [[ ${#all_files[@]} -eq 0 ]]; then
    echo "No existing files found. Creating new file..." >&2
    _create_new_config_file_simple "$config_type"
    return
  fi
  
  local options=()
  for file in "${all_files[@]}"; do
    local line_count
    line_count=$(wc -l < "$file" 2>/dev/null || echo 0)
    options+=("$file|$file ($line_count lines)")
  done
  options+=("[CREATE_NEW]|Create new file")
  
  local selected
  selected=$(printf "%s\n" "${options[@]}" | fzf \
    --delimiter '|' \
    --with-nth=2 \
    --prompt "Select file: " \
    --preview "if [[ {1} == '[CREATE_NEW]' ]]; then echo 'Create new file'; else echo '=== {1} ==='; echo '══════════════════════════════════════'; head -20 {1} 2>/dev/null; fi" 2>/dev/null | \
    cut -d'|' -f1)
  
  if [[ "$selected" == "[CREATE_NEW]" ]]; then
    _create_new_config_file_simple "$config_type"
  else
    echo "$selected"
  fi
}

function _create_new_config_file_simple() {
  local config_type="$1"
  local config_base="${PORTAGE_ETC}/package.$config_type"
  local default_filename=""
  
  case "$config_type" in
    accept_keywords) default_filename="custom-keywords" ;;
    use) default_filename="custom-use" ;;
    mask) default_filename="custom-mask" ;;
    unmask) default_filename="custom-unmask" ;;
    env) default_filename="custom-env" ;;
    *) default_filename="custom-config" ;;
  esac
  
  {
    _print_divider >&2
    echo "Create new file for package.$config_type" >&2
    echo "Enter filename (e.g. custom-$config_type or guru_mask):" >&2
    echo -n "Filename [$default_filename]: " >&2
  }
  
  read -r filename
  filename="${filename:-$default_filename}"
  filename=$(basename "$filename")
  local full_path="$config_base/$filename"
  
  echo "Creating: $full_path" >&2
  
  if ${PRIV_ESC} mkdir -p "$(dirname "$full_path")" && ${PRIV_ESC} touch "$full_path"; then
    echo "SUCCESS: Created $full_path" >&2
    echo "$full_path"
    return 0
  else
    echo "ERROR: Failed to create $full_path" >&2
    return 1
  fi
}

function _add_keyword_entry() {
  local package="$1"
  
  echo
  _print_divider
  echo "Unmasking package (Keyword): $package"
  
  local edited_package
  read -e -i "$package" -p "Edit package atom: " edited_package
  [[ -z "$edited_package" ]] && return 1
  package="$edited_package"
  
  local selected_keyword
  selected_keyword=$(echo -e "~amd64\n~arm64\namd64\narm64\n-**" | fzf --prompt "Select keyword: ")
  [[ -z "$selected_keyword" ]] && return 1
  
  local new_entry="$package $selected_keyword"
  
  echo
  _print_divider
  echo "Select file to add keyword to:"
  local config_file
  config_file=$(_select_config_file "accept_keywords")
  config_file=$(echo "$config_file" | grep -E '^/etc/portage/' | head -1)
  
  if [[ -z "$config_file" ]] || [[ ! -f "$config_file" ]]; then
    _pwrfzf_error "Invalid or no file selected: $config_file"
    return 1
  fi
  
  echo
  _print_divider
  echo "CONFIRM ADDITION:"
  echo "Entry: $new_entry"
  echo "File: $config_file"
  echo
  read -rp "Add this entry? (y/N) " confirm
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    ${PRIV_ESC} mkdir -p "$(dirname "$config_file")"
    
    # Ensure trailing newline safely before appending
    ${PRIV_ESC} bash -c "[[ -s \"$config_file\" && \$(tail -c1 \"$config_file\" | wc -l) -eq 0 ]] && echo \"\" >> \"$config_file\""
    
    if echo "$new_entry" | ${PRIV_ESC} tee -a "$config_file" >/dev/null; then
      _pwrfzf_success "Added to $config_file: $new_entry"
      _clear_preview_cache
      return 0
    else
      _pwrfzf_error "Failed to write to $config_file"
      return 1
    fi
  else
    _pwrfzf_warning "Cancelled"
    return 1
  fi
}

function _edit_sets_conf() {
  _launch_editor "${PORTAGE_ETC}/sets.conf"
}

function _browse_package_sets() {
  local sets_dir="${PORTAGE_ETC}/sets"
  if [[ ! -d "$sets_dir" ]]; then
    echo "No package sets directory found at: $sets_dir"
    return
  fi
  
  while true; do
    local selected_file
    selected_file=$(find "$sets_dir" -mindepth 1 2>/dev/null | fzf \
      --bind 'enter:accept+abort' \
      --bind 'esc:abort' \
      --header "Select package set to edit (Enter=edit, ESC=back)" \
      --preview-window 'right,60%,border-left' \
      --border-label-pos=3 \
      --border 'double' \
      --border-label="┨${PROG} - Package Sets┠" \
      --ansi \
      --color="${pwrfzf_colortheme}" \
      --preview="$PREVIEW_CMD")
    
    [[ -z "$selected_file" ]] && break
    
    if [[ -d "$selected_file" ]]; then
      echo "Cannot edit a directory. Please select a file."
      sleep 1
      continue
    fi
    _launch_editor "$selected_file"
  done
}

function _add_package_set() {
  local sets_dir="${PORTAGE_ETC}/sets"
  local set_name new_set_file
  
  _print_divider
  read -rp "Enter package set name: " set_name
  [[ -z "$set_name" ]] && return
  
  new_set_file="$sets_dir/$set_name"
  
  echo
  _print_divider
  echo "CONFIRM CREATION:"
  echo "Package set: $set_name"
  echo "File: $new_set_file"
  echo
  read -rp "Create this package set? (y/N) " answer
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    ${PRIV_ESC} mkdir -p "$sets_dir"
    ${PRIV_ESC} touch "$new_set_file"
    _pwrfzf_success "Created package set: $set_name"
    
    echo
    read -rp "Edit set now? (y/N) " edit_answer
    if [[ "$edit_answer" =~ ^[Yy]$ ]]; then
      _launch_editor "$new_set_file"
    fi
  fi
}

function _view_current_use_flags() {
  local package="$1"
  echo "=== CURRENT USE FLAGS FOR: $package ==="
  equery uses "$package" 2>/dev/null || echo "Unable to query USE flags"
  echo
  echo "=== PACKAGE.USE CONFIGURATION ==="
  grep -r "$package" "${PORTAGE_ETC}/package.use" 2>/dev/null | head -20 || echo "No custom USE configuration"
  echo
  echo "Press any key to continue..."
  read -n1 -s
}

function _view_available_use_flags() {
  local package="$1"
  echo "=== AVAILABLE USE FLAGS FOR: $package ==="
  local ebuild_path
  ebuild_path=$(equery which "$package" 2>/dev/null)
  if [[ -n "$ebuild_path" ]]; then
    echo "IUSE flags from ebuild:"
    grep -E "^IUSE=" "$ebuild_path" 2>/dev/null | head -1 | sed 's/IUSE=//' | tr -d '"' | xargs -n1 | sort | column
  else
    echo "Unable to find ebuild"
  fi
  echo
  echo "Press any key to continue..."
  read -n1 -s
}

function _remove_use_flags_interactive() {
  local package="$1"
  
  _print_divider
  echo "Remove USE flags for: $package"
  
  local current_config
  current_config=$(grep -r "$package" "${PORTAGE_ETC}/package.use" 2>/dev/null)
  
  if [[ -z "$current_config" ]]; then
    _pwrfzf_warning "No USE flag configuration found for $package"
    return 1
  fi
  
  local config_to_remove
  config_to_remove=$(echo "$current_config" | fzf \
    --prompt "Select configuration to remove: " \
    --preview "echo 'Current entry: {}'")
  
  [[ -z "$config_to_remove" ]] && return 1
  
  local config_file="${config_to_remove%%:*}"
  local config_line="${config_to_remove#*:}"
  
  echo
  _print_divider
  echo "CONFIRM REMOVAL:"
  echo "Entry: $config_line"
  echo "File: $config_file"
  echo
  read -rp "Remove this entry? (y/N) " confirm
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    ${PRIV_ESC} sed -i "\|$config_line|d" "$config_file"
    _pwrfzf_success "Removed from $config_file: $config_line"
    _clear_preview_cache
    return 0
  else
    _pwrfzf_warning "Cancelled"
    return 1
  fi
}

function _unmask_packages() {
  local packages=("$@")
  local real_packages=()
  
  for package in "${packages[@]}"; do
    if [[ "$package" == */* ]]; then
      real_packages+=("$package")
    fi
  done
  
  if [[ ${#real_packages[@]} -eq 0 ]]; then
    _pwrfzf_warning "No valid package names found in: ${packages[*]}"
    return 1
  fi
  
  _pwrfzf_verbose "Unmasking packages: ${real_packages[*]}"
  
  for package in "${real_packages[@]}"; do
    _print_divider
    echo "🛠️ Processing Masked Package: $package"
    
    local mask_info
    mask_info=$(${EMERGE_CMD} --pretend "$package" 2>&1 | grep -A1 "masked by:" | head -2 | tr '\n' ' ')
    
    local needs_keyword=false
    local needs_unmask=false
    
    if [[ "$mask_info" =~ "missing keyword" ]]; then needs_keyword=true; fi
    if [[ "$mask_info" =~ "package.mask" ]]; then needs_unmask=true; fi
    if [[ "$needs_keyword" == "false" && "$needs_unmask" == "false" ]]; then
      needs_keyword=true
      needs_unmask=true
    fi
    
    if [[ "$needs_keyword" == "true" ]]; then
      echo
      echo "👉 Action Required: Add to package.accept_keywords"
      _add_keyword_entry "$package"
    else
      echo
      echo "✅ Keywords are already satisfied (e.g., via make.conf). Skipping accept_keywords."
    fi
    
    if [[ "$needs_unmask" == "true" ]]; then
      echo
      echo "👉 Action Required: Add to package.unmask"
      _add_unmask_entry "$package"
    fi
  done
}

function _add_unmask_entry() {
  local package="$1"
  
  _print_divider
  echo "Unmasking package (Mask): $package"
  
  local edited_package
  read -e -i "$package" -p "Edit package atom (e.g. append ::repo): " edited_package
  [[ -z "$edited_package" ]] && return
  package="$edited_package"
  
  local new_entry="$package"
  
  echo "Select file to add unmask entry:"
  local config_file
  config_file=$(_select_config_file "unmask")
  [[ -z "$config_file" ]] && return
  
  echo
  _print_divider
  echo "CONFIRM ADDITION:"
  echo "Entry: $new_entry"
  echo "File: $config_file"
  echo
  read -rp "Add this entry? (y/N) " answer
  if [[ -z "$answer" || "$answer" =~ ^[Yy]$ ]]; then
    ${PRIV_ESC} mkdir -p "$(dirname "$config_file")"
    ${PRIV_ESC} bash -c "[[ -s \"$config_file\" && \$(tail -c1 \"$config_file\" | wc -l) -eq 0 ]] && echo \"\" >> \"$config_file\""
    echo "$new_entry" | ${PRIV_ESC} tee -a "$config_file" >/dev/null
    _pwrfzf_success "Added to $config_file: $new_entry"
    _clear_preview_cache
  fi
}

# ------------------------------------------------------------------------------
# EMERGE WRAPPERS & ACTIONS
# ------------------------------------------------------------------------------
function _world_update() {
  tput clear 2>/dev/null || clear
  _print_divider
  echo "🌍 Starting World Update"
  _print_divider

  if [[ $(pgrep -c emerge) -gt 1 ]]; then
    _pwrfzf_warning "Emerge is already running. Please wait for it to finish."
    read -n1 -rsp "Press any key to return..." < /dev/tty
    return 1
  fi

  if [[ "${PWRFZF_UPDATE_LOWER_PRIORITY:-false}" == "true" ]]; then
    echo ">>> Lowering priority for smooth background operation (renice & ionice)..."
    ${PRIV_ESC} renice -n 15 $$ >/dev/null 2>&1 || true
    ${PRIV_ESC} ionice -c2 -n6 -p $$ >/dev/null 2>&1 || true
  fi

  echo ">>> Syncing repositories..."
  if ${PRIV_ESC} emaint sync -a < /dev/tty; then
    _pwrfzf_success "Repositories synced successfully."
  else
    _pwrfzf_warning "Repository sync had issues. Proceeding anyway..."
  fi

  if [[ "${PWRFZF_UPDATE_UPDATE_PORTAGE_FIRST:-false}" == "true" ]]; then
    echo
    _print_divider
    echo ">>> Checking for sys-apps/portage updates first..."
    ${EMERGE_CMD} -1u sys-apps/portage < /dev/tty
  fi

  # Extract base parameters globally configured
  local emerge_args=()
  if [[ -n "${EMERGE_DEFAULT_OPTS:-}" ]]; then
    eval "local temp_opts=(${EMERGE_DEFAULT_OPTS:-})"
    local skip_next=false
    for arg in "${temp_opts[@]}"; do
      if [[ "$skip_next" == "true" ]]; then
        if [[ "$arg" == -* ]]; then skip_next=false; else continue; fi
      fi
      if [[ "$arg" == "--buildpkg-exclude" ]]; then skip_next=true; continue; fi
      if [[ "$arg" == --buildpkg-exclude=* ]]; then continue; fi
      if [[ "$arg" == *\** && "$arg" != -* ]]; then continue; fi
      # Do not append -a or --ask as the fallback menu expects interactive control
      if [[ "$arg" != "-a" && "$arg" != "--ask" ]]; then
        emerge_args+=("$arg")
      fi
    done
  fi
  emerge_args+=("-avuDN" "@world")

  echo
  _print_divider
  echo ">>> Calculating updates..."
  
  _install_packages_with_fallback "${emerge_args[@]}"
  local exit_code=$?

  echo
  _print_divider
  if [[ $exit_code -eq 0 ]]; then
    _pwrfzf_success "World update completed successfully!"
    _clear_preview_cache
    
    if [[ "${PWRFZF_UPDATE_PRESERVED_REBUILD:-false}" == "true" ]]; then
      echo ">>> Running preserved-rebuild..."
      ${EMERGE_CMD} -v --keep-going @preserved-rebuild < /dev/tty
    fi
    
    if [[ "${PWRFZF_UPDATE_DEPCLEAN:-false}" == "true" ]]; then
      echo ">>> Running depclean..."
      ${EMERGE_CMD} --quiet-unmerge-warn --quiet --depclean < /dev/tty
    fi

    if [[ "${PWRFZF_UPDATE_CLEAN_LOGS:-false}" == "true" ]]; then
      echo ">>> Cleaning old portage logs..."
      ${PRIV_ESC} emaint -C -t 7 logs < /dev/tty
    fi

    if [[ "${PWRFZF_UPDATE_ECLEAN_PACKAGES:-false}" == "true" ]] && command -v eclean >/dev/null 2>&1; then
      echo ">>> Cleaning stale binpkgs..."
      ${PRIV_ESC} eclean -d packages < /dev/tty
    fi

    if [[ "${PWRFZF_UPDATE_ECLEAN_DISTFILES:-false}" == "true" ]] && command -v eclean-dist >/dev/null 2>&1; then
      echo ">>> Cleaning stale distfiles..."
      ${PRIV_ESC} eclean-dist -f -d < /dev/tty
    fi
    
    if [[ "${PWRFZF_UPDATE_EIX_UPDATE:-false}" == "true" ]] && command -v eix-update >/dev/null 2>&1; then
      echo ">>> Updating eix cache..."
      ${PRIV_ESC} eix-update >/dev/null
    fi
    
    ${PRIV_ESC} sync
    read -n1 -rsp "Press any key to return..." < /dev/tty
  else
    _pwrfzf_error "World update failed."
    read -n1 -rp "View failed build logs to investigate? (y/N) " ans < /dev/tty
    if [[ "$ans" =~ ^[Yy]$ ]]; then _recent_build_logs_viewer; fi
  fi
}

function _install_packages_with_fallback() {
  local emerge_args=("$@")
  local max_retries=3
  local retry_count=0
  
  while [[ $retry_count -lt $max_retries ]]; do
    _print_divider
    echo "Attempt $((retry_count + 1)) of $max_retries"
    echo "Installing: ${emerge_args[*]}"
    
    echo ">>> Running direct installation..."
    ${EMERGE_CMD} "${emerge_args[@]}"
    local emerge_exit_code=$?
    
    if [[ $emerge_exit_code -eq 0 ]]; then
      echo "✅ Package installation completed successfully"
      _clear_preview_cache
      return 0
    elif [[ $emerge_exit_code -eq 130 ]]; then
      echo "⏹️ Installation cancelled by user"
      return 130
    else
      ((retry_count++))
      echo "❌ Installation failed (attempt $retry_count). Analyzing issues..."
      
      local pretend_output
      pretend_output=$(${EMERGE_CMD} --pretend "${emerge_args[@]}" 2>&1)
      local pretend_exit_code=$?
      
      echo
      _print_divider
      echo "DEPENDENCY ANALYSIS:"
      echo "$pretend_output"
      
      if [[ $pretend_exit_code -ne 0 ]]; then
        if echo "$pretend_output" | grep -q "is not a valid package atom"; then
          local invalid_atom
          invalid_atom=$(echo "$pretend_output" | grep "is not a valid package atom" | head -1)
          echo
          _print_divider
          echo "❌ EMERGE SYNTAX ERROR DETECTED:"
          echo "$invalid_atom"
          echo
          echo "This error usually occurs due to unescaped spaces in EMERGE_DEFAULT_OPTS."
          echo "Portage interprets everything after the space as a new package."
          echo "Tip: Use [e]dit in the menu to adjust the incorrectly split arguments!"
          return 1
        fi

        local masked_packages=()
        local use_flag_packages=()
        local use_flag_suggestions=()
        local circular_deps_packages=()
        local circular_deps_suggestions=()
        local keyword_packages=()

        if echo "$pretend_output" | grep -q "masked"; then
          masked_packages=($(echo "$pretend_output" | grep -E "!!!.*masked" | sed -nE 's/.*"([^"]+)".*/\1/p' | sed -e 's/\[.*\]//g' | sort -u))
        fi
        
        if echo "$pretend_output" | grep -q "keyword.*masked"; then
          keyword_packages=($(echo "$pretend_output" | grep -E "!!!.*keyword.*masked" | sed -nE 's/.*"([^"]+)".*/\1/p' | sed -e 's/\[.*\]//g' | sort -u))
        fi

        if echo "$pretend_output" | grep -q "circular dependencies"; then
          local fix_line
          fix_line=$(echo "$pretend_output" | grep -A2 "It might be possible to break this cycle" | grep "Change USE:" | head -1)
          if [[ "$fix_line" =~ -\ ([^[:space:]]+).*Change\ USE:\ ([+-][a-zA-Z0-9_-]+) ]]; then
            circular_deps_packages=("${BASH_REMATCH[1]}")
            circular_deps_suggestions=("${BASH_REMATCH[1]}:${BASH_REMATCH[2]}")
          fi
        fi
        
        local use_line
        use_line=$(echo "$pretend_output" | grep "Change USE:" | head -1)
        if [[ -n "$use_line" ]]; then
          if [[ "$use_line" =~ -\ ([^[:space:]]+).*Change\ USE:\ ([+-][^[:space:]]+) ]]; then
            use_flag_packages+=("${BASH_REMATCH[1]}")
            use_flag_suggestions+=("${BASH_REMATCH[1]}:${BASH_REMATCH[2]}")
          fi
        fi

        echo
        _print_divider
        echo "🛠️  CONFIGURATION ISSUES DETECTED"
        
        local options=()
        local option_descriptions=()
        
        if [[ ${#masked_packages[@]} -gt 0 ]]; then
          options+=("1")
          option_descriptions+=("Unmask packages: ${masked_packages[*]}")
        fi
        
        if [[ ${#keyword_packages[@]} -gt 0 ]]; then
          options+=("2") 
          option_descriptions+=("Add keywords for: ${keyword_packages[*]}")
        fi
        
        if [[ ${#use_flag_packages[@]} -gt 0 ]]; then
          options+=("3")
          option_descriptions+=("Manage USE flags for: ${use_flag_packages[*]}")
        fi
        
        if [[ ${#circular_deps_packages[@]} -gt 0 ]]; then
          options+=("4")
          option_descriptions+=("Fix circular dependencies: ${circular_deps_packages[*]}")
        fi
        
        options+=("5" "6" "7" "8")
        option_descriptions+=("Open Portage config manager (all files)" "Let emerge handle automatically (--autounmask-write)" "Skip problematic packages and retry" "Edit emerge arguments manually")

        for i in "${!options[@]}"; do
          echo "${options[i]}) ${option_descriptions[i]}"
        done
        echo "0) Abort installation"
        
        echo
        read -rp "Select action: " choice
        
        case $choice in
          1)
            if [[ ${#masked_packages[@]} -gt 0 ]]; then
              _unmask_packages "${masked_packages[@]}"
              echo "🔄 Configuration updated. Retrying..."
              continue
            fi
            ;;
          2)
            if [[ ${#keyword_packages[@]} -gt 0 ]]; then
              for pkg in "${keyword_packages[@]}"; do
                _add_keyword_entry "$pkg"
              done
              echo "🔄 Configuration updated. Retrying..."
              continue
            fi
            ;;
          3)
            if [[ ${#use_flag_packages[@]} -gt 0 ]]; then
              _manage_use_flags_interactive "${use_flag_packages[@]}"
              echo "🔄 Configuration updated. Retrying..."
              continue
            fi
            ;;
          4)
            if [[ ${#circular_deps_packages[@]} -gt 0 ]]; then
              if [[ ${#circular_deps_suggestions[@]} -gt 0 ]]; then
                _apply_suggested_use_flags "${circular_deps_suggestions[@]}"
              else
                _manage_use_flags_interactive "${circular_deps_packages[@]}"
              fi
              echo "🔄 Configuration updated. Retrying..."
              continue
            fi
            ;;
          5)
            _portage_config_manager
            echo "🔄 Configuration updated. Retrying..."
            continue
            ;;
          6)
            echo "🔧 Letting Portage generate and write configuration changes..."
            ${EMERGE_CMD} --autounmask-write=y --autounmask=y "${emerge_args[@]}"
            _run_config_updater
            echo "🔄 Retrying with updated configuration..."
            continue
            ;;
          7)
            echo "⏭️ Skipping problematic packages..."
            local all_problem_packages=("${masked_packages[@]}" "${keyword_packages[@]}" "${use_flag_packages[@]}" "${circular_deps_packages[@]}")
            local filtered_args=()
            
            # Safe array filtering in Bash
            for arg in "${emerge_args[@]}"; do
              local skip=false
              for prob in "${all_problem_packages[@]}"; do
                if [[ "$arg" == "$prob" ]]; then
                  skip=true
                  break
                fi
              done
              if [[ "$skip" == "false" && -n "$arg" ]]; then
                filtered_args+=("$arg")
              fi
            done
            emerge_args=("${filtered_args[@]}")
            
            echo "🔄 Retrying without problematic packages..."
            continue
            ;;
          8)
            local new_args
            read -re -i "${emerge_args[*]}" -p "Emerge args: " new_args
            read -ra emerge_args <<< "$new_args"
            echo "🔄 Retrying with new arguments..."
            continue
            ;;
          0|*)
            echo "❌ Installation aborted by user"
            return 1
            ;;
        esac
      else
        echo "❌ Compilation or runtime error detected (Pretend passed but install failed)."
        echo
        read -n1 -rp "Would you like to view the failed build logs to investigate? (y/N) " ans < /dev/tty
        echo
        if [[ "$ans" =~ ^[Yy]$ ]]; then
          _recent_build_logs_viewer
        fi

        if [[ $retry_count -lt $max_retries ]]; then
          echo "🔄 Retrying..."
          continue
        fi
      fi
    fi
  done
  
  echo "❌ Maximum retry attempts reached"
  return 1
}

function _apply_suggested_use_flags() {
  local suggestions=("$@")
  echo "🔧 Applying suggested USE flag changes..."
  
  for suggestion in "${suggestions[@]}"; do
    local pkg="${suggestion%:*}"
    local flag="${suggestion#*:}"
    
    local clean_flag="${flag#[+-]}"
    clean_flag="${clean_flag%)}"
    clean_flag="${clean_flag%%[[:space:]]*}"
    
    _print_divider
    echo "Applying USE flag change:"
    echo "Original package: $pkg"
    echo "USE flag: $clean_flag"
    
    local package_atom
    if [[ "$pkg" =~ -[0-9] ]]; then
      package_atom=">=$pkg"
      echo "Using: $package_atom (this version and newer)"
    else
      package_atom="$pkg"
      echo "Using package: $package_atom"
    fi
    
    local edited_package
    read -e -i "$package_atom" -p "Edit package atom (e.g. append ::repo): " edited_package
    [[ -z "$edited_package" ]] && continue
    package_atom="$edited_package"
    
    echo "Select file to add USE flag:"
    local config_file
    config_file=$(_select_config_file "use")
    config_file=$(echo "$config_file" | grep -E '^/etc/portage/' | head -1)
    
    if [[ -z "$config_file" ]] || [[ ! "$config_file" =~ ^/etc/portage/ ]]; then
      echo "❌ Invalid file selected for $package_atom"
      continue
    fi
    
    local use_entry="$package_atom $clean_flag"
    
    echo
    _print_divider
    echo "CONFIRM ADDITION:"
    echo "Entry: $use_entry"
    echo "File: $config_file"
    echo "Note: USE flag '$clean_flag' will be enabled for $package_atom"
    echo
    read -rp "Add this entry? (y/N) " confirm
    
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
      ${PRIV_ESC} mkdir -p "$(dirname "$config_file")"
      ${PRIV_ESC} bash -c "[[ -s \"$config_file\" && \$(tail -c1 \"$config_file\" | wc -l) -eq 0 ]] && echo \"\" >> \"$config_file\""
      echo "$use_entry" | ${PRIV_ESC} tee -a "$config_file" >/dev/null
      
      if ${PRIV_ESC} grep -q "$package_atom" "$config_file" 2>/dev/null; then
        echo "✅ Added to $config_file: $use_entry"
        _clear_preview_cache
      else
        echo "❌ Failed to verify entry in $config_file"
      fi
    else
      echo "⚠️ Skipped USE flag change for $pkg"
    fi
  done
  return 0
}

function _manage_use_flags_interactive() {
  local packages=("$@")
  _pwrfzf_verbose "Managing USE flags for packages: ${packages[*]}"
  
  for package in "${packages[@]}"; do
    _print_divider
    echo "Managing USE flags for: $package"
    
    while true; do
      local action
      action=$(echo -e "View current USE flags\nAdd USE flags\nRemove USE flags\nView available USE flags\nSkip this package\nDone with this package" | fzf \
        --bind 'esc:abort' \
        --header "Manage USE flags for: $package" \
        --preview-window 'right,60%,border-left' \
        --border-label-pos=3 \
        --border 'double' \
        --border-label="┨${PROG} - USE Flags┠" \
        --ansi \
        --color="${pwrfzf_colortheme}" \
        --preview="bash -c '\"${BASH_SOURCE[0]}\" _use_flags_preview \"$package\" {}'")
      
      case "$action" in
        "View current USE flags") _view_current_use_flags "$package" ;;
        "Add USE flags") _add_use_flags_interactive "$package" ;;
        "Remove USE flags") _remove_use_flags_interactive "$package" ;;
        "View available USE flags") _view_available_use_flags "$package" ;;
        "Skip this package") break ;;
        "Done with this package"|"") break ;;
      esac
    done
  done
}

function _use_flags_preview() {
  local package="$1"
  local action="$2"
  
  case "$action" in
    "View current USE flags")
      echo "=== CURRENT USE FLAGS FOR: $package ==="
      equery uses "$package" 2>/dev/null || echo "Unable to query USE flags"
      echo
      echo "=== CURRENT PACKAGE.USE CONFIGURATION ==="
      grep -r "$package" "${PORTAGE_ETC}/package.use" 2>/dev/null | head -10 || echo "No custom USE configuration"
      ;;
    "Add USE flags")
      echo "=== AVAILABLE USE FLAGS FOR: $package ==="
      local ebuild_path
      ebuild_path=$(equery which "$package" 2>/dev/null)
      if [[ -n "$ebuild_path" ]]; then
        grep -E "^IUSE=" "$ebuild_path" 2>/dev/null | head -1 | sed 's/IUSE=//' | tr -d '"' | xargs -n1 | sort | column
      else
        echo "Unable to find ebuild"
      fi
      echo
      echo "=== CURRENT CONFIGURATION ==="
      grep -r "$package" "${PORTAGE_ETC}/package.use" 2>/dev/null | head -5 || echo "No current configuration"
      ;;
    "Remove USE flags")
      echo "=== CURRENT USE CONFIGURATION ==="
      grep -r "$package" "${PORTAGE_ETC}/package.use" 2>/dev/null | head -10 || echo "No configuration to remove"
      ;;
    "View available USE flags")
      echo "=== ALL AVAILABLE USE FLAGS FOR: $package ==="
      local ebuild_path
      ebuild_path=$(equery which "$package" 2>/dev/null)
      if [[ -n "$ebuild_path" ]]; then
        echo "IUSE flags from ebuild:"
        grep -E "^IUSE=" "$ebuild_path" 2>/dev/null | head -1 | sed 's/IUSE=//' | tr -d '"' | xargs -n1 | sort
        echo
        echo "Global USE flags (from make.conf):"
        grep -E "^USE=" "${PORTAGE_ETC}/make.conf" 2>/dev/null | head -1 | sed 's/USE=//' | tr -d '"' | xargs -n1 | sort | head -20
      else
        echo "Unable to find ebuild for $package"
      fi
      ;;
  esac
}

function _add_use_flags_interactive() {
  local package="$1"
  
  _print_divider
  echo "Add USE flags for: $package"
  
  local edited_package
  read -e -i "$package" -p "Edit package atom: " edited_package
  [[ -z "$edited_package" ]] && return 1
  package="$edited_package"
  
  local available_flags=()
  local ebuild_path
  ebuild_path=$(equery which "$package" 2>/dev/null)
  
  if [[ -n "$ebuild_path" ]]; then
    available_flags=($(grep -E "^IUSE=" "$ebuild_path" 2>/dev/null | head -1 | sed 's/IUSE=//' | tr -d '"' | xargs -n1 | sort))
  fi
  
  if [[ ${#available_flags[@]} -eq 0 ]]; then
    _pwrfzf_error "No USE flags found for $package"
    return 1
  fi
  
  local selected_flags=()
  while true; do
    local flag
    flag=$(printf "%s\n" "${available_flags[@]}" "DONE" | fzf \
      --prompt "Select USE flag to add (DONE when finished): " \
      --preview "echo 'Flag: {}'")
    
    if [[ "$flag" == "DONE" ]]; then
      break
    elif [[ -n "$flag" ]]; then
      selected_flags+=("$flag")
      _pwrfzf_verbose "Selected flag: $flag"
    fi
  done
  
  if [[ ${#selected_flags[@]} -eq 0 ]]; then
    _pwrfzf_warning "No USE flags selected"
    return 1
  fi
  
  local use_entry="$package"
  for flag in "${selected_flags[@]}"; do
    local action
    action=$(echo -e "Enable $flag\nDisable $flag" | fzf --prompt "Action for $flag: ")
    if [[ "$action" == "Enable $flag" ]]; then
      use_entry+=" $flag"
    elif [[ "$action" == "Disable $flag" ]]; then
      use_entry+=" -$flag"
    fi
  done
  
  echo
  _print_divider
  echo "Select file to add USE flags:"
  local config_file
  config_file=$(_select_config_file "use")
  config_file=$(echo "$config_file" | grep -E '^/etc/portage/' | head -1)
  
  if [[ -z "$config_file" ]] || [[ ! "$config_file" =~ ^/etc/portage/ ]]; then
    _pwrfzf_error "Invalid file selected"
    return 1
  fi
  
  echo
  _print_divider
  echo "CONFIRM ADDITION:"
  echo "Entry: $use_entry"
  echo "File: $config_file"
  echo
  read -rp "Add this entry? (y/N) " confirm
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    ${PRIV_ESC} mkdir -p "$(dirname "$config_file")"
    
    # Ensure trailing newline safely before appending
    ${PRIV_ESC} bash -c "[[ -s \"$config_file\" && \$(tail -c1 \"$config_file\" | wc -l) -eq 0 ]] && echo \"\" >> \"$config_file\""
    
    if echo "$use_entry" | ${PRIV_ESC} tee -a "$config_file" >/dev/null; then
      _pwrfzf_success "Added to $config_file: $use_entry"
      _clear_preview_cache
      return 0
    else
      _pwrfzf_error "Failed to write to $config_file"
      return 1
    fi
  else
    _pwrfzf_warning "Cancelled"
    return 1
  fi
}

function _view_current_use_flags() {
  local package="$1"
  echo "=== CURRENT USE FLAGS FOR: $package ==="
  equery uses "$package" 2>/dev/null || echo "Unable to query USE flags"
  echo
  echo "=== PACKAGE.USE CONFIGURATION ==="
  grep -r "$package" "${PORTAGE_ETC}/package.use" 2>/dev/null | head -20 || echo "No custom USE configuration"
  echo
  echo "Press any key to continue..."
  read -n1 -s
}

function _view_available_use_flags() {
  local package="$1"
  echo "=== AVAILABLE USE FLAGS FOR: $package ==="
  local ebuild_path
  ebuild_path=$(equery which "$package" 2>/dev/null)
  if [[ -n "$ebuild_path" ]]; then
    echo "IUSE flags from ebuild:"
    grep -E "^IUSE=" "$ebuild_path" 2>/dev/null | head -1 | sed 's/IUSE=//' | tr -d '"' | xargs -n1 | sort | column
  else
    echo "Unable to find ebuild"
  fi
  echo
  echo "Press any key to continue..."
  read -n1 -s
}

function _remove_use_flags_interactive() {
  local package="$1"
  
  _print_divider
  echo "Remove USE flags for: $package"
  
  local current_config
  current_config=$(grep -r "$package" "${PORTAGE_ETC}/package.use" 2>/dev/null)
  
  if [[ -z "$current_config" ]]; then
    _pwrfzf_warning "No USE flag configuration found for $package"
    return 1
  fi
  
  local config_to_remove
  config_to_remove=$(echo "$current_config" | fzf \
    --prompt "Select configuration to remove: " \
    --preview "echo 'Current entry: {}'")
  
  [[ -z "$config_to_remove" ]] && return 1
  
  local config_file="${config_to_remove%%:*}"
  local config_line="${config_to_remove#*:}"
  
  echo
  _print_divider
  echo "CONFIRM REMOVAL:"
  echo "Entry: $config_line"
  echo "File: $config_file"
  echo
  read -rp "Remove this entry? (y/N) " confirm
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    ${PRIV_ESC} sed -i "\|$config_line|d" "$config_file"
    _pwrfzf_success "Removed from $config_file: $config_line"
    _clear_preview_cache
    return 0
  else
    _pwrfzf_warning "Cancelled"
    return 1
  fi
}

function _unmask_packages() {
  local packages=("$@")
  local real_packages=()
  
  for package in "${packages[@]}"; do
    if [[ "$package" == */* ]]; then
      real_packages+=("$package")
    fi
  done
  
  if [[ ${#real_packages[@]} -eq 0 ]]; then
    _pwrfzf_warning "No valid package names found in: ${packages[*]}"
    return 1
  fi
  
  _pwrfzf_verbose "Unmasking packages: ${real_packages[*]}"
  
  for package in "${real_packages[@]}"; do
    _print_divider
    echo "🛠️ Processing Masked Package: $package"
    
    local mask_info
    mask_info=$(${EMERGE_CMD} --pretend "$package" 2>&1 | grep -A1 "masked by:" | head -2 | tr '\n' ' ')
    
    local needs_keyword=false
    local needs_unmask=false
    
    if [[ "$mask_info" =~ "missing keyword" ]]; then needs_keyword=true; fi
    if [[ "$mask_info" =~ "package.mask" ]]; then needs_unmask=true; fi
    if [[ "$needs_keyword" == "false" && "$needs_unmask" == "false" ]]; then
      needs_keyword=true
      needs_unmask=true
    fi
    
    if [[ "$needs_keyword" == "true" ]]; then
      echo
      echo "👉 Action Required: Add to package.accept_keywords"
      _add_keyword_entry "$package"
    else
      echo
      echo "✅ Keywords are already satisfied (e.g., via make.conf). Skipping accept_keywords."
    fi
    
    if [[ "$needs_unmask" == "true" ]]; then
      echo
      echo "👉 Action Required: Add to package.unmask"
      _add_unmask_entry "$package"
    fi
  done
}

function _add_unmask_entry() {
  local package="$1"
  
  _print_divider
  echo "Unmasking package (Mask): $package"
  
  local edited_package
  read -e -i "$package" -p "Edit package atom (e.g. append ::repo): " edited_package
  [[ -z "$edited_package" ]] && return
  package="$edited_package"
  
  local new_entry="$package"
  
  echo "Select file to add unmask entry:"
  local config_file
  config_file=$(_select_config_file "unmask")
  [[ -z "$config_file" ]] && return
  
  echo
  _print_divider
  echo "CONFIRM ADDITION:"
  echo "Entry: $new_entry"
  echo "File: $config_file"
  echo
  read -rp "Add this entry? (y/N) " answer
  if [[ -z "$answer" || "$answer" =~ ^[Yy]$ ]]; then
    ${PRIV_ESC} mkdir -p "$(dirname "$config_file")"
    ${PRIV_ESC} bash -c "[[ -s \"$config_file\" && \$(tail -c1 \"$config_file\" | wc -l) -eq 0 ]] && echo \"\" >> \"$config_file\""
    echo "$new_entry" | ${PRIV_ESC} tee -a "$config_file" >/dev/null
    _pwrfzf_success "Added to $config_file: $new_entry"
    _clear_preview_cache
  fi
}

# ------------------------------------------------------------------------------
# MAIN EXECUTION WRAPPER
# ------------------------------------------------------------------------------
function _pwrfzf_main() {
  local ARGS=() SearchInput=""
  local BASE_EMERGE_ARGS=("--ask")
  
  rm -f "${PWRFZF_CACHE_DIR}/.show_installed"
  
  if command -v portageq >/dev/null 2>&1; then
    local env_opts
    env_opts=$(portageq envvar EMERGE_DEFAULT_OPTS 2>/dev/null)
    [[ -n "$env_opts" ]] && EMERGE_DEFAULT_OPTS="$env_opts"
  fi

  set -f
  if [[ -n "${EMERGE_DEFAULT_OPTS:-}" ]]; then
    eval "local temp_opts=(${EMERGE_DEFAULT_OPTS:-})"
    local skip_next=false
    for arg in "${temp_opts[@]}"; do
      if [[ "$skip_next" == "true" ]]; then
        if [[ "$arg" == -* ]]; then skip_next=false; else continue; fi
      fi
      if [[ "$arg" == "--buildpkg-exclude" ]]; then skip_next=true; continue; fi
      if [[ "$arg" == --buildpkg-exclude=* ]]; then continue; fi
      if [[ "$arg" == *\** && "$arg" != -* ]]; then continue; fi
      BASE_EMERGE_ARGS+=("$arg")
    done
  fi
  set +f

  while [[ $# -gt 0 ]]; do
    case $1 in
      -h|--help) _pwrfzf_help; exit 0 ;;
      --help-full) _pwrfzf_help_full; exit 0 ;;
      -k|--keybindings) _pwrfzf_keys; exit 0 ;;
      -V|--version) _pwrfzf_version; exit 0 ;;
      -c|--config) _portage_config_manager; exit 0 ;;
      --sync) ${PRIV_ESC} emaint sync -a; exit 0 ;;
      --depclean) ${EMERGE_CMD} -a --depclean; exit 0 ;;
      --preserved-rebuild) ${EMERGE_CMD} -1 @preserved-rebuild; exit 0 ;;
      -*) BASE_EMERGE_ARGS+=("$1") ;;
      *) ARGS+=("$1") ;;
    esac
    shift
  done
  
  SearchInput="${ARGS[*]}"
  
  local fzf_search_opts=()
  [[ "${PWRFZF_SEARCH_NAMES_ONLY:-false}" == "true" ]] && fzf_search_opts+=("--nth=1")
  
  local last_selected_packages=()
  local auto_retry=false
  
  while true; do
    local PICKS=()
    local PKGS=()
    local emerge_args=("${BASE_EMERGE_ARGS[@]}")
    
    if [[ "$auto_retry" == "true" && ${#last_selected_packages[@]} -gt 0 ]]; then
      echo "🔄 Auto-retrying installation with previously selected packages..."
      PKGS=("${last_selected_packages[@]}")
      auto_retry=false
    else
      local fzf_header_text="Press ? for keys | Ctrl+o: Config & Mgmt | Ctrl+w: World Update"
      if [[ "${PWRFZF_ENABLE_KERNEL_HUB:-false}" == "true" ]]; then
        fzf_header_text+=" | Ctrl+k: System Hub"
      fi

      # Robust FZF options using a Bash array to prevent word-splitting bugs
      local fzf_args=(
        --bind "ctrl-r:execute(pkgs=\$(echo {+1} | tr -d ':'); [[ -n \"\$pkgs\" ]] && ${EMERGE_CMD} -aC \$pkgs < /dev/tty; echo; read -n1 -rsp 'Press any key to return...' < /dev/tty)"
        --bind "ctrl-x:execute(${EMERGE_CMD} -a --depclean < /dev/tty; echo; read -n1 -rsp 'Press any key to return...' < /dev/tty)"
        --bind "ctrl-w:execute(${BASH_SOURCE[0]} _world_update)"
        --bind "ctrl-z:execute(${EMERGE_CMD} -1 @preserved-rebuild < /dev/tty; echo; read -n1 -rsp 'Press any key to return...' < /dev/tty)"
        --bind "ctrl-s:execute(${PRIV_ESC} emaint sync -a < /dev/tty; echo; read -n1 -rsp 'Press any key to return...' < /dev/tty)"
        --bind "ctrl-o:execute(${BASH_SOURCE[0]} -c)"
        --bind "alt-u:execute(${BASH_SOURCE[0]} _run_config_updater)"
        --bind "ctrl-y:execute(${BASH_SOURCE[0]} _show_emerge_history)"
        --bind "ctrl-p:reload(\"${BASH_SOURCE[0]}\" _toggle_installed \"${PWRFZF_FZF_LAYOUT}\")"
        --bind 'ctrl-/:change-preview-window(up,border-rounded|up,40%,border-rounded|left,border-rounded|left,border-rounded,40%|down,border-rounded|down,40%,border-rounded|down,10%,border-rounded|hidden|right,40%,border-rounded|right,70%,border-rounded|right,90%,border-rounded)'
        --bind 'ctrl-l:clear-query+clear-screen+clear-selection'
        --bind 'alt-bspace:clear-query'
        --bind 'alt-left:kill-word'
        --bind "esc:abort"
        --bind 'ctrl-q:abort'
        --bind 'ctrl-d:deselect-all'
        --bind 'ctrl-i:toggle'
        --bind 'ctrl-v:toggle-preview'
        --bind 'alt-n:next-history'
        --bind 'alt-p:previous-history'
        --bind 'right:first'
        --bind 'left:last'
        --bind 'end:first'
        --bind 'home:last'
        --bind 'pgdn:page-down'
        --bind 'pgup:page-up'
        --bind "?:preview(echo '$(_pwrfzf_keys)')"
        --bind "ctrl-h:preview(echo '$(_pwrfzf_keys)')"
        --bind "change:first"
        --header "$fzf_header_text"
        --header-lines=1
        --preview-window "$PWRFZF_PREVIEW_WINDOW"
        --history="$PWRFZF_HISTORY"
        --query="${SearchInput}"
        --preview-label-pos=top
        --border-label-pos=3
        --border 'double'
        --preview-label="╣${SearchInput:-pwrfzf}╠"
        --border-label="┨${PROG}┠"
        --info=inline
        --scroll-off=20
        --hscroll-off=30
        --ellipsis="⣿"
        --tiebreak=begin
        --sync
        --multi
        --delimiter ' '
        --ansi
        --color="${pwrfzf_colortheme}"
        --preview="bash -c '\"${BASH_SOURCE[0]}\" __fzf_preview {1}'"
      )

      if [[ "${PWRFZF_ENABLE_KERNEL_HUB:-false}" == "true" ]]; then
        fzf_args+=(--bind "ctrl-k:execute(${BASH_SOURCE[0]} _kernel_hub)")
      fi

      # PERFORMANCE BOOST: mapfile avoids slow Bash interpretation of fzf output lines
      mapfile -t PICKS < <(__emerge_list "$SearchInput" | fzf "${fzf_search_opts[@]}" "${fzf_args[@]}")
      
      # Exit logic: Check if we cancelled FZF
      if [[ ${#PICKS[@]} -eq 0 ]]; then
        if [[ "${PWRFZF_CONFIRM_EXIT}" == "true" ]]; then
          echo
          _print_divider
          read -rp "Exit PWRFZF? (Y/n): " exit_ans
          if [[ -z "$exit_ans" || "$exit_ans" =~ ^[Yy]$ ]]; then
            _clear_preview_cache
            exit 0
          else
            continue
          fi
        else
          _clear_preview_cache
          exit 0
        fi
      fi
      
      # Safe Regex Package Extraction 
      # Guarantees only the pure package name passes to emerge, sans spaces or colons.
      for PICK in "${PICKS[@]}"; do
        local atom="${PICK%% *}"
        atom="${atom%:}"
        if [[ -n "$atom" ]]; then
          PKGS+=("$atom")
        fi
      done
      
      last_selected_packages=("${PKGS[@]}")
    fi
    
    if [[ ${PWRFZF_CONFIRM_ACTIONS} == "true" ]]; then
      local confirm_loop=true
      while [[ "$confirm_loop" == "true" ]]; do
        if [[ ${#PKGS[@]} -eq 0 ]]; then
          echo "⚠️ No packages left to install."
          auto_retry=false
          break # Exit the menu to return to search
        fi

        _print_divider
        echo "CONFIRM INSTALLATION:"
        echo "Selected packages: ${PKGS[*]}"
        echo "Current command: ${EMERGE_CMD} ${emerge_args[*]} ${PKGS[*]}"
        echo
        echo "Options:"
        echo "  [y] Yes, proceed with current command"
        echo "  [n] No, cancel and return to search (default)"
        echo "  [o] Add --oneshot (-1) flag"
        echo "  [d] Add --depclean (-c) flag (safe removal)"
        echo "  [e] Edit emerge arguments manually"
        echo "  [r] Remove packages from selection"
        echo "  [s] Save selected packages to a Portage Set (Install List)"
        echo
        read -rp "Your choice (y/N/o/d/e/r/s): " answer
        
        case "${answer,,}" in
          y|yes) confirm_loop=false ;;
          o|oneshot) emerge_args+=("--oneshot"); echo "✅ Added --oneshot flag." ;;
          d|depclean) emerge_args+=("--depclean"); echo "✅ Added --depclean flag." ;;
          s|save)
            echo
            read -rp "Enter set name (e.g., custom_install_list): " set_name
            if [[ -n "$set_name" ]]; then
              ${PRIV_ESC} mkdir -p "${PORTAGE_ETC}/sets"
              for p in "${PKGS[@]}"; do
                 echo "$p" | ${PRIV_ESC} tee -a "${PORTAGE_ETC}/sets/$set_name" >/dev/null
              done
              echo "✅ Saved ${#PKGS[@]} packages to ${PORTAGE_ETC}/sets/$set_name"
            fi
            ;;
          e|edit)
            local new_args
            read -re -i "${emerge_args[*]}" -p "Emerge args: " new_args
            read -ra emerge_args <<< "$new_args"
            ;;
          r|remove)
            local pkgs_to_remove
            pkgs_to_remove=$(printf "%s\n" "${PKGS[@]}" | fzf --multi --header="Select packages to REMOVE (Tab to multi-select, Enter to confirm)" --prompt="Remove> ")
            if [[ -n "$pkgs_to_remove" ]]; then
              local new_pkgs=()
              for p in "${PKGS[@]}"; do
                if ! echo "$pkgs_to_remove" | grep -qxF "$p"; then new_pkgs+=("$p"); fi
              done
              PKGS=("${new_pkgs[@]}")
              last_selected_packages=("${PKGS[@]}")
              echo "✅ Selection updated."
            fi
            ;;
          *)
            echo "⚠️ Installation cancelled"
            auto_retry=false
            confirm_loop=false
            PKGS=() # Clear the array so installation is skipped
            ;;
        esac
      done
      [[ ${#PKGS[@]} -eq 0 ]] && continue
    fi
    
    _install_packages_with_fallback "${emerge_args[@]}" "${PKGS[@]}"
    local install_result=$?
    
    if [[ $install_result -eq 2 ]]; then
      echo "🔄 Configuration updated. Auto-retrying installation..."
      auto_retry=true
      continue
    elif [[ $install_result -eq 130 ]]; then
      echo "⏹️ Installation cancelled by user"
      auto_retry=false
      continue
    fi
    auto_retry=false
  done
}

# ------------------------------------------------------------------------------
# ENTRY POINT
# ------------------------------------------------------------------------------
case "${1:-}" in
  __fzf_preview)
    __fzf_preview "$2"
    exit 0
    ;;
  _config_preview|_action_preview|_sets_action_preview|_toggle_installed|_get_glsa_list|_toggle_glsa|_snapper_preview)
    # ⚠️ Data streams for FZF - absolutely no terminal output allowed here!
    # Any 'echo' or 'printf' to stdout will corrupt the FZF interface.
    # Therefore, _pwrfzf_verbose logs silently to file here.
    function _pwrfzf_verbose() { _pwrfzf_log "VERBOSE: $*"; }
    _load_config
    _validate_config
    _set_colors
    _find_privilege_escalator
    _find_emerge
    "$1" "${@:2}"
    exit 0
    ;;
  _show_emerge_history|_run_config_updater|_world_update|_btrfs_snapshot_menu|_kernel_hub)
    # Interactive FZF execute wrappers
    _load_config
    _validate_config
    _set_colors
    _find_privilege_escalator
    _find_emerge
    "$1" "${@:2}"
    exit 0
    ;;
  *)
    _pwrfzf_init
    _pwrfzf_main "$@"
    ;;
esac
