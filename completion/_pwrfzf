#compdef pwrfzf

_pwrfzf() {
  local -a args

  args=(
    '(-h --help)'{-h,--help}'[Show the help menu]'
    '--help-full[Show the extended help menu]'
    '(-k --keybindings)'{-k,--keybindings}'[List keybindings]'
    '(-V --version)'{-V,--version}'[Show version]'
    '(-c --config)'{-c,--config}'[Manage Portage configuration]'
    '--depclean[Run emerge --depclean]'
    '--preserved-rebuild[Run preserved rebuild]'
    '--sync[Sync repositories]'
  )

  _arguments -C \
    "${args[@]}" \
    ':query:_files'
}
